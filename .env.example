# Client (Vite) — exposed to the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
VITE_N8N_FEEDBACK_URL=
VITE_N8N_CLEO_TRANSFORM_URL=
VITE_N8N_VISIBILITY_DEEP_ENRICH_URL=

# Home surfaces shipped behind flags. Default to on; set to "false" to hide.
VITE_DAILY_FOCUS_ENABLED=true
VITE_TASKS_INBOX_ENABLED=true
# Weekly takeover + Full Focus Mode ship opt-in (default off). Set to "true" to enable.
VITE_WEEKLY_FOCUS_ENABLED=false
VITE_FOCUS_MODE_ENABLED=false
# Unified Focus Ritual: one guided stepper across portfolio/week/today + an
# altitude spine, with the decision panels demoted to a read-only board.
# Supersedes HomeV2 + the standalone weekly takeover when on. Default off.
VITE_FOCUS_RITUAL_ENABLED=false
# Growth Scoreboard on Home: the three growth engines (content subscribers via
# Maven + both Substacks, app subscriptions, network reach) with trends and
# stall chips, fed by the daily /api/growth/snapshot cron. Default off.
VITE_GROWTH_SCOREBOARD_ENABLED=false
# Relume-based UI v2. When on, the Network tab becomes one server-ranked search
# surface over all 10,670 people (semantic + keyword + weighted soft constraints,
# with voice), replacing the client-side substring filter over a capped 1,000-row
# page. REQUIRES the two network migrations applied and
# scripts/network/import-intelligence.ts run with --commit and --embed; the new
# surface reads tables that do not exist until then. Default off.
VITE_UI_V2_ENABLED=false
# Simplified IA (12 tabs -> 6): Today folds into Home's decision queue,
# Pipeline/Network/Visibility become the People tab, Org/Intel/Flows/Systems
# become the OS tab, Subscriptions demotes to the drawer. Default off.
VITE_IA_V3_ENABLED=false
# Pilot capacity layer: the morning energy/anxiety reading shapes how much the
# dashboard asks of the operator. Low capacity asks for one daily target instead
# of three, stops the OS demanding portfolio and weekly decisions, keeps the
# ambient fold shut, and softens motion and contrast. It only ever reduces what
# the screen demands, never adds. Default off. Set "true" + redeploy to roll out.
VITE_PILOT_CAPACITY_ENABLED=false
# Content Engine: transform-axes, Challenge-this, channel variants, the Five
# Standards gate, and Push-to-Cleo, layered on the Content tab. Default off;
# set "true" + redeploy to dogfood. Existing Content inbox UI stays when off.
VITE_CONTENT_ENGINE_ENABLED=false

# Server (Vercel API routes + edge middleware) — never exposed to the browser
# ACCESS_CODE arms the edge gate (middleware.ts) that keeps the dashboard from
# being publicly browsable. Leave unset to disable the gate (fails open).
ACCESS_CODE=
# Origin allowed to call the access-gated /api/network/* routes. These pin their
# CORS origin instead of sending `*`, because a wildcard next to a cookie gate is
# how the gate gets read by any page the browser happens to be on. Defaults to
# the production host when unset.
APP_ORIGIN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SYNC_SECRET=
N8N_API_KEY=
N8N_API_BASE_URL=
N8N_FEEDBACK_URL=

# N8N webhook URLs proxied by /api/* routes — keep server-side so they're
# rotatable without a frontend redeploy and not visible in bundle.
N8N_EMAIL_DRAFT_WEBHOOK_URL=
N8N_LEAD_DEEP_ENRICH_WEBHOOK_URL=
N8N_VISIBILITY_DEEP_ENRICH_WEBHOOK_URL=
N8N_CLEO_TRANSFORM_WEBHOOK_URL=
# Omnichannel Content Factory (Push-to-Cleo final polish → Google Doc + Telegram).
# Live path: https://krishraja10101.app.n8n.cloud/webhook/content-factory
N8N_CONTENT_FACTORY_WEBHOOK_URL=

# Content Engine enrichment (Challenge-this). Perplexity is required; NewsAPI optional.
# Also powers the weekly GEO citation probe (/api/growth/geo-probe).
PERPLEXITY_API_KEY=
NEWSAPI_KEY=
ANTHROPIC_API_KEY=
# Apify community scraping for Challenge (real Reddit/LinkedIn practitioner takes).
# APIFY_TOKEN optional — without it, Challenge falls back to the Perplexity forum pass.
# Actor slugs default to a registered Reddit actor; LinkedIn is opt-in.
APIFY_TOKEN=
APIFY_REDDIT_ACTOR=automation-lab/reddit-scraper
APIFY_LINKEDIN_ACTOR=

# Skill Forge (Section 4 — /api/skills/*)
# Also used by api/_embeddings.ts (text-embedding-3-small) for cross-surface
# dedup + narrative clustering on the Content tab. Without it, the semantic
# tier degrades silently to canonical URL + title + content-hash matching.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
SKILL_DELIVERY_WEBHOOK_URL=

# Internal webhook auth. Gates server→server endpoints (api/dedup/check.ts etc.)
# via the X-Agatha-Secret header. Same value held by the n8n callback workflows.
AGATHA_WEBHOOK_SECRET=

# Vercel cron auth. Every cron route in vercel.json accepts either Vercel's own
# x-vercel-cron header or `Authorization: Bearer $CRON_SECRET` for manual runs.
CRON_SECRET=

# Krish's approvals channel (@krish_approvals_bot), used by the weekly growth
# council (/api/growth/council-run) to push its summary. Both must be set or the
# council skips the ping and reports the skip; it never fails the run.
TELEGRAM_APPROVALS_BOT_TOKEN=
TELEGRAM_APPROVALS_CHAT_ID=

# Direct (non-n8n) enrichment + Apollo burn-down (api/_enrich.ts, api/_apollo.ts,
# scripts/apollo/*). Apollo is the structured B2B source + lead search/reveal;
# the rest are best-effort fallbacks, each independently gated on its key.
APOLLO_API_KEY=
PEOPLE_DATA_LABS_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=

# Google Workspace service account (Gmail drafts + Drive/Docs) via domain-wide
# delegation. PRIVATE_KEY is the PEM with literal \n newlines. IMPERSONATE_SUBJECT
# is the Workspace user to act as (krish@themindmaker.ai). DRIVE_FOLDER_ID targets
# a Shared Drive folder for generated docs (optional).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_IMPERSONATE_SUBJECT=krish@themindmaker.ai
GOOGLE_DRIVE_FOLDER_ID=

# Stripe revenue pull (api/revenue/sync.ts). Restricted keys with READ access to
# balance transactions, invoices and subscriptions are enough; no write scope.
# One per Stripe account. Without these the sync no-ops rather than failing.
STRIPE_API_KEY=
STRIPE_API_KEY_FRACTIONL=
