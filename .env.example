# Client (Vite) — exposed to the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
VITE_N8N_FEEDBACK_URL=
VITE_N8N_CLEO_TRANSFORM_URL=
VITE_N8N_VISIBILITY_DEEP_ENRICH_URL=

# Home surfaces shipped behind flags. Default to on; set to "false" to hide.
VITE_TASKS_INBOX_ENABLED=true
# (2026-08-20 recompose) VITE_DAILY_FOCUS_ENABLED, VITE_WEEKLY_FOCUS_ENABLED,
# VITE_FOCUS_MODE_ENABLED, VITE_FOCUS_RITUAL_ENABLED and VITE_IA_V3_ENABLED are
# retired: the ritual Home, the daily 3, focus lanes and the 6-tab IA are
# committed in code. Values set in Vercel for them are ignored.
# Relume-based UI v2. When on, the Network tab becomes one server-ranked search
# surface over all 10,670 people (semantic + keyword + weighted soft constraints,
# with voice), replacing the client-side substring filter over a capped 1,000-row
# page. REQUIRES the two network migrations applied and
# scripts/network/import-intelligence.ts run with --commit and --embed; the new
# surface reads tables that do not exist until then. Default off.
VITE_UI_V2_ENABLED=false
# Pilot capacity layer: the morning energy/anxiety reading shapes how much the
# dashboard asks of the operator. Low capacity stops the OS demanding weekly
# planning and softens motion and contrast. It only ever reduces what the
# screen demands, never adds — today is always exactly 3 regardless.
# Default off. Set "true" + redeploy to roll out.
VITE_PILOT_CAPACITY_ENABLED=false
# Video Engine mobile control plane. Keep false until the migration, private
# preview bucket, server secrets, and Windows runner are all verified.
VITE_VIDEO_ENGINE_ENABLED=false

# Server (Vercel API routes + edge middleware) — never exposed to the browser
# ACCESS_CODE arms the edge gate (middleware.ts) that keeps the dashboard from
# being publicly browsable. Leave unset to disable the gate (fails open).
ACCESS_CODE=
# Origin allowed to call the access-gated /api/network/* routes. These pin their
# CORS origin instead of sending `*`, because a wildcard next to a cookie gate is
# how the gate gets read by any page the browser happens to be on. Video Engine
# routes fail closed when this exact HTTPS origin is unset (HTTP is loopback-only).
APP_ORIGIN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Write-only bearer for AI clients posting redacted harness observations.
HARNESS_EVENT_INGEST_TOKEN=
# Separate read-only bearer used by the ai-harness GitHub observer.
HARNESS_EVENT_EXPORT_TOKEN=
# The Video Engine's own secrets (CSRF, the runner bearer and signing key, the
# MCP gateway bearer, the preview bucket) moved to the content-engine project
# with the routes that read them, 2026-09-08. They are set there, not here.
# ACCESS_CODE and APP_ORIGIN above must hold the SAME values in both projects:
# the browser's cookie and CSRF guards run in the engine across the rewrite.
SYNC_SECRET=
N8N_API_KEY=
N8N_API_BASE_URL=
N8N_FEEDBACK_URL=
# Dedicated bearer for n8n -> /api/internal/sonnet-proxy. Keep separate from
# CRON_SECRET so a compromised workflow cannot invoke unrelated cron routes.
N8N_PROXY_SECRET=

# N8N webhook URLs proxied by /api/* routes — keep server-side so they're
# rotatable without a frontend redeploy and not visible in bundle.
N8N_EMAIL_DRAFT_WEBHOOK_URL=
N8N_LEAD_DEEP_ENRICH_WEBHOOK_URL=
N8N_VISIBILITY_DEEP_ENRICH_WEBHOOK_URL=
N8N_CLEO_TRANSFORM_WEBHOOK_URL=
# The content factory webhook and the Challenge-this enrichment keys (NewsAPI,
# the Apify actor slugs) moved to the content-engine project with the Composer
# routes, 2026-09-08.

# Perplexity still powers the weekly GEO citation probe (/api/growth/geo-probe)
# and the enrichment this repo keeps for leads, guests and the Room.
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
APIFY_TOKEN=

# Skill Forge (Section 4 — /api/skills/*)
# Also used by api/_embeddings.ts (text-embedding-3-small) for cross-surface
# dedup + narrative clustering on the Content tab. Without it, the semantic
# tier degrades silently to canonical URL + title + content-hash matching.
OPENAI_API_KEY=
# Task-specific defaults. OPENAI_MODEL remains a backwards-compatible global
# override; leave it blank unless you intentionally want one model for both.
OPENAI_MODEL=
OPENAI_JUDGE_MODEL=gpt-5.4-nano
OPENAI_SKILL_MODEL=gpt-5.4-mini
OPENAI_GENERATION_MODEL=gpt-5.4-mini

# ---------------------------------------------------------------------------
# The rescue provider (api/_providerFallback.ts)
#
# Anthropic was unavailable three times in September 2026 and not once was it a
# model failure: a dead key on the 15th, a spend cap on the 20th, and an
# eight-day org usage lockout on the 23rd. All three were billing events on one
# account, so the answer is a second billing relationship. OpenRouter is it.
#
# Required for the fallback to work at all. Without it, callClaude,
# callClaudeMessages and streamClaude raise their own Anthropic error instead of
# answering, which is the behaviour this repo had before 2026-09-23.
#
# FUND THE ACCOUNT. A key with no credits is configured and useless, and it
# fails on the one day it is needed — which is exactly how 23 Gemini fallback
# nodes sat dead for months behind a free-tier Google key. Probed 2026-09-24:
# this key reported is_free_tier true, total_credits 0, and a hard $100 key
# limit. Watch the balance on the Spend surface like Apify's prepaid line.
OPENROUTER_API_KEY=

# The understudies. LIKE-FOR-LIKE since 2026-09-24, which is a reversal: this
# was a cheap-tier demotion (gpt-5.4-nano / gpt-5.4-mini) on the assumption that
# standing in with the same model was the expensive option. Measured against the
# live credential, that assumption was wrong. OpenRouter serves Anthropic models
# at LIST PRICE with no per-token markup, and prompt caching survives the hop at
# exactly the multipliers api/_prices.ts models (5m write 1.25x, 1h write 2.0x,
# read 0.1x). A demotion would now buy nothing but a worse answer on the
# surfaces Krish reads during an outage.
#
# What keeps this bounded is unchanged and is NOT the model tier: bulk paths opt
# out by name (enrich-person alone ran 3,284 calls in a day), and a daily call
# ceiling applies — system_config key `rescue_fallback_daily_call_cap`, default
# 400, which supersedes `openai_fallback_daily_call_cap`.
#
# Note these are OpenRouter slugs: dots, not the dashes Anthropic's own API ids
# use. They deliberately have no row in api/_prices.ts, because OpenRouter
# returns the real cost per call and the meter records that instead of deriving
# one from a second rate table that would have to agree with the invoice.
RESCUE_JUDGE_MODEL=anthropic/claude-haiku-4.5
RESCUE_GENERATION_MODEL=anthropic/claude-sonnet-5
SKILL_DELIVERY_WEBHOOK_URL=

# Internal webhook auth. Gates server→server endpoints (api/dedup/check.ts etc.)
# via the X-Agatha-Secret header. Same value held by the n8n callback workflows.
AGATHA_WEBHOOK_SECRET=

# Vercel cron auth. Every cron route in vercel.json accepts either Vercel's own
# x-vercel-cron header or `Authorization: Bearer $CRON_SECRET` for manual runs.
CRON_SECRET=

# Telegram is retired (2026-10-03). Nothing reads a TELEGRAM_* variable, so
# delete any left in Vercel. Ops alerts are recorded in audit_log and shown in
# the app; nothing is pushed to a phone (api/_alert.ts).

# Direct (non-n8n) enrichment + Apollo burn-down (api/_enrich.ts, api/_apollo.ts,
# scripts/apollo/*). Apollo is the structured B2B source + lead search/reveal;
# the rest are best-effort fallbacks, each independently gated on its key.
#
# These same keys back "add a person from a screenshot"
# (api/network/{scan-card,add-person,enrich-person}.ts). One difference matters
# there: an UNSET key is a silent skip, but a key that is present and REFUSED
# (402 / 401 / 429) stops the enrichment and raises an alert rather than
# writing a half-enriched record. See api/_quota.ts. The alert is recorded in
# audit_log + api_usage_state and shown in the UI; nothing is pushed to a phone.
#
# OPENAI_API_KEY is load-bearing for that flow, not optional: without an
# embedding, contact_intelligence.embedding is null and the person is invisible
# to Network search — i.e. "added to the network" would not be true.
APOLLO_API_KEY=
PEOPLE_DATA_LABS_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=

# Google Workspace service account (Gmail drafts + Drive/Docs) via domain-wide
# delegation. PRIVATE_KEY is the PEM with literal \n newlines. IMPERSONATE_SUBJECT
# is the Workspace user to act as (krish@themindmaker.ai). DRIVE_FOLDER_ID targets
# a Shared Drive folder for generated docs (optional).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_IMPERSONATE_SUBJECT=krish@themindmaker.ai
# One-time Google sign-in for the accounts the service account cannot reach
# (hello@krishraja.com, krishanraja@gmail.com). A Web OAuth client in Google
# Cloud with redirect URI https://controlcenter.krishraja.com/api/google/callback.
# Used by api/google/connect.ts, api/google/callback.ts, api/_relationshipSync.ts.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
# The LinkedIn data export held in Drive (api/network/import-linkedin-messages.ts).
# FILE_ID is the Drive id of messages.csv inside it; DRIVE_OWNER is the Workspace
# user whose Drive holds it, impersonated to read it, and defaults to
# krish@mindmake.co. Reading it needs drive.readonly on the service account's
# domain-wide delegation, which gmail.readonly and calendar.readonly sit beside.
LINKEDIN_MESSAGES_FILE_ID=
LINKEDIN_CONNECTIONS_FILE_ID=
GOOGLE_DRIVE_OWNER=krish@mindmake.co
# GA4 Data API (api/growth/snapshot.ts, api/growth/web-insights.ts). Optional
# dedicated service account for GA only; when unset, the GOOGLE_SERVICE_ACCOUNT_*
# pair above is used. Add THIS email as Viewer on the Google Analytics account
# (one grant covers all four properties).
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=
# NUMERIC property ids from GA Admin →
# Property details, not the G- measurement ids. The service account above must
# be a Viewer on each property and the Analytics Data API enabled in its project.
GA4_PROPERTY_MINDMAKE_SITE=
# makeyourmindup's tag lives on mindmakerlive.substack.com, not the dormant
# makeyourmindup.substack.com.
GA4_PROPERTY_MAKEYOURMINDUP=
# fulltime.fm and legibility.io. The code carries their numeric ids as defaults
# (src/lib/webProperties.ts: 556143202 and 556114272); set these only to override.
GA4_PROPERTY_FULLTIME=
GA4_PROPERTY_LEGIBILITY=
# Plausible Stats API key for mindmake.co (api/_plausible.ts). Google Analytics
# there counts only visitors who press Allow, by design; Plausible counts every
# visit and holds the site's events. Unset = the site card asks for it once.
PLAUSIBLE_API_KEY=

# Stripe revenue pull (api/revenue/sync.ts, api/_stripe.ts).
#
# PREFER THE ORG KEY. One Stripe organisation key reads all five accounts when
# each request carries `Stripe-Context: acct_...`, so there is one credential to
# rotate instead of five, and Control Center only ever needs READ. Set this and
# the five per-account vars below can stay empty. Measured on 2026-10-05: it
# answers /charges, /balance_transactions, /subscriptions, /products, /prices,
# /invoices and /customers on every account. It does NOT carry `webhook_read`,
# which nothing here needs.
STRIPE_ORG_KEY=
# Per-account fallback, used only when STRIPE_ORG_KEY is unset. Restricted keys
# with READ access to balance transactions, invoices and subscriptions are
# enough; no write scope. Without any of these the sync no-ops rather than
# failing.
STRIPE_API_KEY=
STRIPE_API_KEY_FRACTIONL=
STRIPE_API_KEY_FULLTIME=
STRIPE_API_KEY_LEGIBILITY=
STRIPE_API_KEY_HEARTSIDE=

# Stripe webhook signing secrets, one per account, for POST
# /api/revenue/webhook?account=<key> (api/revenue/webhook.ts). The route FAILS
# CLOSED: with no secret for an account it refuses the event with 503 rather
# than trusting it. That is the opposite of the n8n intake it replaces, which
# verified only `if (secret && ...)` and so processed everything while the
# secret store sat empty. A secret may instead live in
# system_config.stripe_webhook_signing_secrets, keyed by account; the env var
# wins. Never commit a value: scripts/check-no-secrets.mts rejects `whsec_`.
STRIPE_WEBHOOK_SECRET_MINDMAKER_LLC=
STRIPE_WEBHOOK_SECRET_FULL_TIME=
STRIPE_WEBHOOK_SECRET_LEGIBILITY=
STRIPE_WEBHOOK_SECRET_FRACTIONL_AI=
STRIPE_WEBHOOK_SECRET_HEARTSIDE=

# Heartside's Shopify store (Shopify Payments, not Stripe). A Dev Dashboard
# custom app shows no token: the client credentials grant trades its client id
# and this secret for a token that lasts 24 hours, minted fresh per use and
# never stored. The client id and the store domain are not secret and live in
# api/_connections.ts. Read-only scopes: read_orders, read_customers,
# read_products, read_shopify_payments_payouts. Watched by the connections
# sweep as `shopify-heartside`, strictly, because Shopify answers a wrong
# secret with HTTP 400.
SHOPIFY_HEARTSIDE_CLIENT_SECRET=

# Spend & connections tracker (api/health/connections-sweep.ts,
# api/spend/ingest.ts, GET /api/spend).
#
# The sweep resolves each provider key by the env var NAME stored in
# service_registry.env_key_name: deploy env first, then the service-role-only
# app_secrets table (key = the same name lower-cased), so a provider can be
# wired without a redeploy. A missing key is an honest "no key" state in the
# UI, never an error — set only the ones you use. The full name list lives in
# the service_registry seed (supabase/migrations/*_spend_and_connections.sql);
# names already documented above (OPENAI, ANTHROPIC, PERPLEXITY, APIFY, APOLLO,
# PEOPLE_DATA_LABS, EXA, BRAVE, NEWSAPI, N8N, STRIPE_*) are reused
# as-is. New ones the sweep understands:
#   GEMINI_API_KEY, DEEPSEEK_API_KEY, MOONSHOT_API_KEY, XAI_API_KEY,
#   VERCEL_TOKEN, GITHUB_TOKEN, CLOUDFLARE_API_TOKEN, EXPO_TOKEN,
#   INSTANTLY_API_KEY, RESEND_API_KEY, NEVERBOUNCE_API_KEY,
#   PHANTOMBUSTER_API_KEY, BROWSERLESS_API_KEY, BUILTWITH_API_KEY,
#   FIREFLIES_API_KEY, ELEVENLABS_API_KEY, COINGECKO_API_KEY, FMP_API_KEY,
#   FRED_API_KEY, MARKETAUX_API_KEY, FOOTBALL_DATA_API_KEY,
#   API_FOOTBALL_API_KEY, ARTIFICIAL_ANALYSIS_API_KEY, SERPER_API_KEY
#
# Receipts ingest reads the Gmail "Subscriptions" label through the Google
# service account above — its domain-wide delegation grant must include
# https://www.googleapis.com/auth/gmail.readonly (Google Admin console step);
# until then the route answers 503 rather than reporting an empty month.
GMAIL_SPEND_LABEL_ID=Label_863902844335276794

# ── One swing (ADR-016) ─────────────────────────────────────────────────────
# The scorecard's Rule 6 tripwire counts commits by Krish across these repos
# every Friday (api/scorecard/github-sync.ts). Hours are an estimate: commits
# times UNASKED_HOURS_PER_COMMIT, labelled as such everywhere it renders.
# Read by two Saturday crons: api/scorecard/github-sync.ts (the Rule 6
# tripwire, commits counted as unasked hours) and api/discover-build-signals.ts
# (the same commits offered to the Content Engine as build signals; which
# repos may be named in content is decided in api/_buildSignals.ts, not here).
GITHUB_TOKEN=
GITHUB_REPOS=krishanraja/control-center,krishanraja/mindmake
# GITHUB_AUTHOR is no longer read (2026-09-07): every commit in every listed
# repo counts, because session commits carry the coding agent's address.
UNASKED_HOURS_PER_COMMIT=0.5
# When a partner exists, the Monday scorecard is also written as a Gmail draft
# to them. A draft, never a send (api/scorecard/monday.ts).
PARTNER_EMAIL=
# The Bridges lane (hunter, the job search) is parked. Build-time flag; set
# to true only if the job search resumes.
# VITE_BRIDGES_LANE_ENABLED is retired. The Hunt lane is always on
# (src/lib/bridgesLane.ts); a stale "false" here hid it from Krish for
# eight days after he asked for it back.

# ---------------------------------------------------------------------------
# Named here because scripts/check-env-example.mts fails the build for any
# variable the code reads that this file does not list. Server-side only.
# ---------------------------------------------------------------------------
# Where ops alerts are mailed from api/_alert.ts. Optional.
OPS_ALERT_EMAIL=
# Bearer the Studio uses to read the candidates export (api/video-studio/candidates.ts).
VIDEO_STUDIO_EXPORT_TOKEN=
# The n8n instance base URL for the connections sweep (api/_connections.ts).
N8N_BASE_URL=
# The mm-ctrl headlines pool moved to the content-engine project with feed
# ingest, 2026-09-08 (CTRL_SUPABASE_URL, CTRL_SUPABASE_SERVICE_KEY).
# n8n webhooks the acquisition lanes call (api/acquisition/*).
N8N_DIRECTION_PROPAGATION_WEBHOOK_URL=
N8N_ACQUISITION_DISPATCH_WEBHOOK_URL=
# Secret the guest scout accepts alongside CRON_SECRET (api/discover-guest-scout.ts).
LENS_RADAR_SECRET=
# n8n webhooks for the guest and lead pipelines (api/guests/*, api/leads/*).
N8N_SPEAKER_BRIEFING_WEBHOOK_URL=
N8N_GUEST_CONFIRMED_CASCADE_URL=
N8N_GUEST_DOC_INGEST_URL=
N8N_LEAD_DOC_INGEST_URL=
# The job-search tool: repository (owner/name) and a fine-grained token that
# may fire repository_dispatch on it (api/hunter/run.ts).
HUNTER_REPO=
HUNTER_DISPATCH_TOKEN=
# The AEO research machine (krishanraja/AEO-Engine, GitHub Actions). The engine
# proves AEO_ENGINE_SECRET as a bearer on api/aeo/context, api/aeo/ingest and
# api/aeo/run; Run now on the Growth tab fires repository_dispatch on AEO_REPO
# with AEO_DISPATCH_TOKEN (a fine-grained token scoped to that repo).
AEO_ENGINE_SECRET=
AEO_DISPATCH_TOKEN=
AEO_REPO=
