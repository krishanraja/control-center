{
  // The serverless tree, and ONLY the serverless tree.
  //
  // These files run on Vercel under real Node ESM ("type": "module"), which is
  // why the module settings are NodeNext rather than the app's bundler
  // resolution: it is the only configuration that reproduces how the code will
  // actually be resolved in production. That matters more here than anywhere
  // else in the repo, because a bad specifier is not a compile failure at
  // deploy time — the function builds, ships, and then fails to load on the
  // first request with FUNCTION_INVOCATION_FAILED.
  //
  // That is not hypothetical. Two routes were doing exactly that, unnoticed,
  // because this config existed but was never a CI gate:
  //   api/automations/index.ts   imported './_supabase.js'    (one level short)
  //   api/leads/[id]/index.ts    imported '../_supabase.js'   (one level short)
  // Both returned HTTP 500 on every request in production.
  //
  //   npm run typecheck:api
  //
  // This IS a CI gate now (.github/workflows/ci.yml). Keep it at zero.
  //
  // scripts/ deliberately moved out to tsconfig.scripts.json: those run under
  // tsx, where extensionless and .ts-suffixed imports are correct, so holding
  // them to NodeNext produced 23 errors that were not bugs.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": false,
    "allowJs": false
  },
  "include": ["api"]
}
