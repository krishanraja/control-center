        "jsCode": "const item = $input.first();\nconst blocks = item.json.content || [];\nconst text = blocks.map(b => b.text || '').join('\\n').trim();\nlet parsed = null;\ntry {\n  const a = text.indexOf('{');\n  const b = text.lastIndexOf('}');\n  if (a >= 0 && b > a) parsed = JSON.parse(text.slice(a, b + 1));\n} catch (e) { parsed = null; }\nconst fl = $('Fetch Lead').item.json; const src = Array.isArray(fl) ? fl[0] : fl;\nreturn [{ json: { id: src.id, ...(parsed || {}) } }];"
