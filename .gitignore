node_modules/
dist/
.env
.env.local
.DS_Store
*.log
.vercel/
public/data/_archived/
# Local Claude Code state stays out. Two exceptions are committed: the
# repository's settings (the Supabase allow list) and its own skills, which
# a routine-started session reads (.claude/skills/walkthrough).
.claude/*
!.claude/settings.json
!.claude/skills/
test-results/
# The docs steward's sparse checkout of control-center inside a fleet repo
.steward/

# Supabase CLI scratch state, never committed
supabase/.temp/
.vercel
.env*

# The layout audit writes screenshots + a JSON report here on every run.
# It is evidence for one session, not a build artefact to carry in the repo.
audit/

# The visibility shot spec writes evidence screenshots here on demand
# (VISIBILITY_SHOTS=1). Same reason as audit/: evidence, not source.
shots/
