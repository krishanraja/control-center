        "jsCode": "// The unsubscribe link carries the address as ?e=. It is checked here, and the\n// writes run in the HTTP steps that follow, over the stored Supabase\n// credential. This node used to make them itself with the service-role key\n// written into its source (moved 2026-10-03).\nconst qy = $input.first().json.query || {};\nconst email = String(qy.e || '').trim().toLowerCase();\nconst valid = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email);\nreturn [{ json: { email, valid } }];\n"
      },
