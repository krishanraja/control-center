    {
      "id": "Build_Tasks",
      "name": "Build Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        304
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst guest = $('Fetch Guest').first().json[0];\nif (!guest) throw new Error('guest not found');\n\nconst now = new Date();\nconst scheduledAt = guest.scheduled_at ? new Date(guest.scheduled_at) : new Date(now.getTime() + 14 * 24 * 3600 * 1000);\nconst prepAt = new Date(scheduledAt.getTime() - 7 * 24 * 3600 * 1000);\nconst followupAt = new Date(scheduledAt.getTime() + 3 * 24 * 3600 * 1000);\n\nconst target = guest.podcast_target === 'signal_noise' ? 'Signal & Noise'\n              : guest.podcast_target === 'built' ? 'Built'\n              : 'podcast';\n\nconst rid = () => 'task_g_' + guest.id.slice(0,8) + '_' + Math.random().toString(36).slice(2,8);\n\nreturn [\n  { json: {\n      id: rid(),\n      title: `Prep brief: ${guest.name} (${target})`,\n      description: `Research questions, recent work, hot takes. Why fit: ${guest.why_fit || 'see guest record'}.`,\n      status: 'todo',\n      priority: 'P1',\n      owner: 'krish',\n      agent: 'nell',\n      due_date: prepAt.toISOString(),\n      group: 'podcast_prep',\n      group_label: target,\n      link_primary: guest.linkedin_url || guest.personal_url || null,\n      next_step: 'Draft 8-10 question outline.',\n  }},\n  { json: {\n      id: rid(),\n      title: `Record: ${guest.name} (${target})`,\n      description: `Recording session with ${guest.name}. Confirm tech setup 30 min prior.`,\n      status: 'todo',\n      priority: 'P0',\n      owner: 'krish',\n      agent: 'nell',\n      due_date: scheduledAt.toISOString(),\n      group: 'podcast_recording',\n      group_label: target,\n      link_primary: guest.linkedin_url || guest.personal_url || null,\n      next_step: 'Show up, hit record.',\n  }},\n  { json: {\n      id: rid(),\n      title: `Follow-up: thank ${guest.name} + share clip`,\n      description: '72h post-recording: send thank-you, share preview clip, ask about preferred promo angles.',\n      status: 'todo',\n      priority: 'P2',\n      owner: 'krish',\n      agent: 'nell',\n      due_date: followupAt.toISOString(),\n      group: 'podcast_followup',\n      group_label: target,\n      next_step: 'Draft 4-line thank-you, attach clip url.',\n  }},\n];\n"
      }
    },
