      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst guest = $('Fetch Guest').first().json[0];\nconst target = guest.podcast_target === 'signal_noise' ? 'Signal & Noise'\n              : guest.podcast_target === 'built' ? 'Built' : 'the podcast';\nconst scheduledAt = guest.scheduled_at ? new Date(guest.scheduled_at) : null;\nconst scheduledStr = scheduledAt ? scheduledAt.toUTCString() : 'a time we will confirm shortly';\n\nconst subject = `Confirmed: ${target} recording`;\nconst body = [\n  `Hi ${guest.name.split(' ')[0]},`,\n  '',\n  `Locking us in for ${scheduledStr}.`,\n  '',\n  'Will send the recording link 48 hours before. If anything changes on your end, just reply here.',\n  '',\n  'Topics I am most excited to dig into come straight from your work, will send a question outline a few days before.',\n  '',\n  'Thanks,',\n  'Krish',\n].join('\\n');\n\nreturn [{ json: { to: guest.email, subject, body, has_email: !!guest.email }}];\n"
      }
