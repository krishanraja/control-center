      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"model\": \"claude-sonnet-4-6\", \"max_tokens\": 2000, \"temperature\": 0.5, \"system\": \"You draft 3 promo posts for a confirmed podcast recording, in Krish Raja's voice. Krish hosts Signal & Noise (deep tech and culture) and Built (operators and founders). Return ONLY a JSON array of 3 objects. Each: {channel, body, suggested_send_at_offset_days}. channel: linkedin, twitter, or email_teaser. linkedin: 2-4 sentences, punchy, real angle on what we will discuss, no humble brag. twitter: under 240 chars, one strong line, can include 1 hashtag max. email_teaser: 4-6 sentence newsletter blurb teasing the conversation. Voice rules: concrete, opinionated, no corporate filler, no em dashes (use commas, colons, parentheses), no exclamation marks, no emoji.\", \"messages\": [{\"role\": \"user\", \"content\": \"Guest confirmed for {{ $('Fetch Guest').first().json[0].podcast_target }}: {{ $('Fetch Guest').first().json[0].name }}. One-liner: {{ $('Fetch Guest').first().json[0].one_liner }}. Why fit: {{ $('Fetch Guest').first().json[0].why_fit }}. Draft the 3 promo posts.\"}]}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "w8sWwz8EfYc1JA7G",
          "name": "Anthropic Header 2026-05-21"
        }
      }
    },
    {
      "id": "Parse_Promos",
      "name": "Parse Promos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1584,
        480
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst guest = $('Fetch Guest').first().json[0];\nlet text = $input.first().json.content?.[0]?.text || '';\ntext = text.trim();\nif (text.startsWith('```')) text = text.replace(/^```(?:json)?\\n?/, '').replace(/\\n?```$/, '');\nlet rows;\ntry { rows = JSON.parse(text); } catch { rows = []; }\nif (!Array.isArray(rows)) rows = [];\n\nconst target = guest.podcast_target === 'signal_noise' ? 'Signal & Noise'\n              : guest.podcast_target === 'built' ? 'Built' : 'podcast';\n\nreturn rows.slice(0, 3).map(r => ({ json: {\n  idea: `${r.channel} promo for ${guest.name} (${target})`,\n  thesis: r.body || '(no body)',\n  distribution: r.channel,\n  status: 'draft',\n  source: 'guest_confirmed_cascade',\n  confidence: 0.7,\n  quality_score: 'amber',\n  raw_data: { guest_id: guest.id, channel: r.channel, suggested_offset_days: r.suggested_send_at_offset_days },\n}}));\n"
      }
    },
