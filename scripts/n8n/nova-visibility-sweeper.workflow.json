        "jsCode": "\n// Drop any row whose event_url already exists in visibility_targets.\nconst incoming = $('Parse + Validate').first().json.rows || [];\nconst existing = $input.first().json || [];\nconst seen = new Set(existing.map(r => r.event_url).filter(Boolean));\nconst fresh = incoming.filter(r => !seen.has(r.event_url));\nreturn fresh.map(r => ({ json: r }));\n"
