        360
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Supabase Insert returns the inserted rows as an array in the response body.\n// HTTP Request node wraps this as $json. If the array is the body, we explode it.\nconst items = $input.all();\nconst out = [];\nfor (const item of items) {\n  const body = item.json;\n  if (Array.isArray(body)) {\n    for (const row of body) out.push({ json: row });\n  } else if (body && Array.isArray(body.data)) {\n    for (const row of body.data) out.push({ json: row });\n  } else if (body && body.id) {\n    out.push({ json: body });\n  }\n}\nreturn out;\n"
      }
