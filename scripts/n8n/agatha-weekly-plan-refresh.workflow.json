        "additionalFields": {},
        "text": "=Plan refresh complete\nOn track: {{ $('Parse').first().json.on_track }}/{{ $('Parse').first().json.total }} agents\nBlocked: {{ $('Parse').first().json.blocked.length }}\n\n{{ $('Parse').first().json.blocked.length === 0 ? '' : $('Parse').first().json.blocked.map(a => '- ' + a.agent_id + ': ' + a.silent_failures_7d + ' silent failures, ' + a.failed_runs_7d + ' failed runs (7d)').join('\\n') }}\n\nOpen Plans tab: https://control-center-mindmaker.vercel.app/plans"
