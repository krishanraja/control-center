      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        304
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst raw = $json;\nlet arr = Array.isArray(raw) ? raw : (raw && Array.isArray(raw[Object.keys(raw)[0]]) ? raw[Object.keys(raw)[0]] : []);\nif (typeof arr === 'string') { try { arr = JSON.parse(arr); } catch (_) { arr = []; } }\nconst blocked = arr.filter(a => a.silent_failures_7d > 0 || (a.failed_runs_7d > 0 && a.successful_runs_7d === 0));\nconst onTrack = arr.length - blocked.length;\nreturn [{ json: { total: arr.length, on_track: onTrack, blocked, agents: arr } }];\n"
      }
    },
    {
      "id": "d8b0890f-ff25-495f-8ee8-a9e511ac5523",
