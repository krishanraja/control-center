    {
      "name": "Supabase: Upsert Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        440,
        500
      ],
      "parameters": {
        "method": "POST",
        "url": "https://gojpffsrxybbpbdzzrvs.supabase.co/rest/v1/customers?on_conflict=product,stripe_customer_id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const webhookData = $node[\"Stripe Webhook\"].json;\n  const evt = webhookData.body || webhookData;\n  const t = (evt.type || '').toLowerCase();\n  const obj = evt.data?.object || {};\n  const isPaid    = t === 'checkout.session.completed' || t === 'invoice.payment_succeeded' || t === 'customer.subscription.created' || t === 'customer.subscription.updated';\n  const isChurned = t === 'customer.subscription.deleted';\n  const kind      = isChurned ? 'churned' : isPaid ? 'paid' : 'paid';\n  const product   = 'fractionl_circle';\n  const customerId = obj.customer || obj.id || null;\n  const email      = obj.customer_email || obj.customer_details?.email || obj.receipt_email || null;\n  const name       = obj.customer_details?.name || obj.metadata?.full_name || null;\n  const plan       = obj.plan?.nickname || obj.items?.data?.[0]?.price?.nickname || obj.metadata?.plan || null;\n  const mrr        = obj.plan?.amount ? obj.plan.amount / 100 : (obj.amount_total ? obj.amount_total / 100 : (obj.amount_paid ? obj.amount_paid / 100 : null));\n  const utm        = obj.metadata?.utm_source || obj.metadata?.attribution_channel || null;\n  const now        = new Date().toISOString();\n  const lu         = $json || {};\n  const lead       = lu.id ? lu : (Array.isArray(lu) && lu.length > 0 ? lu[0] : null);\n  const attribution_lead_id    = lead ? lead.id : null;\n  const attribution_task_id    = lead ? (lead.promoted_task_id || null) : null;\n  const attribution_channel    = lead ? (utm || ('agent:' + (lead.assignee_agent || 'unknown'))) : (utm || null);\n  const attribution_confidence = lead ? 'exact_email' : (utm ? 'utm' : 'unattributed');\n  return JSON.stringify({\n    product, kind, email, full_name: name,\n    stripe_customer_id: customerId,\n    stripe_subscription_id: obj.subscription || obj.id || null,\n    plan, mrr_usd: mrr,\n    became_paid_at: isPaid && !isChurned ? now : null,\n    churned_at:     isChurned ? now : null,\n    source: utm,\n    raw: evt,\n    attribution_lead_id, attribution_task_id, attribution_channel, attribution_confidence,\n  });\n})() }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
