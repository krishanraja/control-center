      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst raw = $json;\nlet arr = Array.isArray(raw) ? raw : (raw && Array.isArray(raw[Object.keys(raw)[0]]) ? raw[Object.keys(raw)[0]] : []);\nif (typeof arr === 'string') { try { arr = JSON.parse(arr); } catch (_) { arr = []; } }\nreturn [{ json: { count: arr.length, failures: arr } }];\n"
      }
    },
