    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(i => i.json);\n// Get latest entry per agent_id\nconst latest = {};\nfor (const row of rows) {\n  if (!row.agent_id) continue;\n  if (!latest[row.agent_id] || row.timestamp > latest[row.agent_id].timestamp) {\n    latest[row.agent_id] = row;\n  }\n}\n// Also get N8N workflow statuses - last 24 agents\nconst agents = Object.values(latest);\nconst n8n_flows = rows.filter(r => r.type === 'workflow').slice(-24);\nreturn [{\n  json: {\n    agents,\n    n8n_flows,\n    last_updated: new Date().toISOString(),\n    total_agents: agents.length,\n    running: agents.filter(a => a.status === 'running').length,\n    blocked: agents.filter(a => a.status === 'blocked' || a.status === 'error').length\n  }\n}];\n"
      },
      "id": "transform",
      "name": "Get Latest Per Agent",
      "type": "n8n-nodes-base.code",
