      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const resp=$json||{};\nif(resp.errors&&resp.errors.length){throw new Error('Podchaser error: '+JSON.stringify(resp.errors).slice(0,200));}\nconst pods=(((resp.data||{}).podcasts||{}).data)||[];\nconst cands=pods.filter(p=>p&&p.id).map(p=>({title:p.title,url:p.webUrl,episodes:p.numberOfEpisodes,latest:(p.latestEpisodeDate||'').slice(0,10),desc:(p.description||'').slice(0,240)}));\nconst sys=\"Podcast booking strategist for Krish Raja (Mindmaker AI advisory for non-technical execs; host of Signal & Noise). KEEP only shows whose audience is business leaders/executives/founders/operators (NOT engineers), active (episode in last ~6 months), that interview outside guests. Return ONLY a JSON array of {title,url,why_relevant,suggested_talk_title,tier}. tier A or B. Skip defunct/solo/technical shows.\";\nreturn [{json:{candidate_count:cands.length,anthropic_payload:{model:\"claude-sonnet-4-6\",max_tokens:2500,temperature:0.2,system:sys,messages:[{role:\"user\",content:\"Candidates:\\n\"+JSON.stringify(cands)}]}}}];"
      },
      "id": "158b80b2-b8af-48d0-a029-c1d3e910faa3"
    },
