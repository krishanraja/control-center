    {
      "name": "Map Visibility Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const txt=(($json.content||[])[0]||{}).text||'[]';\nlet arr=[];try{let t=txt.trim();if(t.startsWith('```'))t=t.split('```')[1].replace(/^json/,'').trim();arr=JSON.parse(t);}catch(e){}\nfunction slug(s){return (s||'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/-+/g,'-').replace(/^-|-$/g,'');}\nconst rows=arr.filter(k=>k&&k.url).map(k=>({title:k.title,type:'podcast',status:'queued',source:'nova_podchaser_weekly',event_url:k.url,source_url:k.url,why_relevant:k.why_relevant,suggested_talk_title:k.suggested_talk_title,quality_score:(k.tier==='A'?'green':'amber'),audience_seniority:'business_leaders',concept_id:'concept:vis:'+slug(k.title)}));\nreturn [{json:{row_count:rows.length,upsert_rows:rows}}];"
      },
      "id": "f895c2a6-4aaf-4eb2-aec8-29ad3003221a"
