    {
      "name": "Build Identity Prepend",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        200
      ],
      "parameters": {
        "jsCode": "const briefArr = $('Load Agent Brief').all().map(i => i.json);\nconst planArr  = $('Load Agent Plan').all().map(i => i.json);\n\nconst briefRaw = briefArr[0];\nconst briefRow = Array.isArray(briefRaw) ? briefRaw[0] : (briefRaw && briefRaw.data ? briefRaw.data[0] : briefRaw);\nconst brief = (briefRow && briefRow.brief_content) || '';\n\nconst voice = 'Write as Krish Raja: direct, specific, no hedging. No em dashes. No filler adjectives. Concrete artifacts and numbers over abstractions.';\n\nconst planRaw = planArr[0];\nconst plan = Array.isArray(planRaw) ? (planRaw[0] || {}) : (planRaw && planRaw.data ? (planRaw.data[0] || {}) : (planRaw || {}));\n\nconst planBlock = (plan.current_phase || plan.objective) ? (\n  'CURRENT PLAN:\\n' +\n  (plan.current_phase   ? 'Phase: ' + plan.current_phase + '\\n' : '') +\n  (plan.objective       ? 'Objective: ' + plan.objective + '\\n' : '') +\n  (plan.next_milestone  ? 'Next milestone: ' + plan.next_milestone + '\\n' : '') +\n  (plan.blockers        ? 'Blockers: ' + plan.blockers + '\\n' : '') +\n  (plan.doc_link        ? 'Plan doc: ' + plan.doc_link + '\\n' : '') +\n  (plan.status          ? 'Status: ' + plan.status + '\\n' : '') +\n  '\\n'\n) : '';\n\nconst identity_prepend =\n  (brief ? 'AGENT BRIEF:\\n' + brief + '\\n\\n' : '') +\n  planBlock +\n  'VOICE RULES:\\n' + voice + '\\n\\n';\n\nlet plan_stale = false;\nif (!plan.last_rendered_at) {\n  plan_stale = true;\n} else {\n  const ageMs = Date.now() - new Date(plan.last_rendered_at).getTime();\n  if (isNaN(ageMs) || ageMs > 72 * 3600 * 1000) plan_stale = true;\n}\n\nlet jobs = [];\ntry {\n  jobs = $('Dedup Against Seen Roles').all().map(i => i.json).filter(j => j && !j._empty);\n} catch (e) { jobs = []; }\n\nif (!jobs.length) {\n  return [{ json: { identity_prepend, plan_stale } }];\n}\nreturn jobs.map(j => ({ json: { ...j, identity_prepend, plan_stale } }));\n"
      },
      "executeOnce": true,
      "id": "8475c972-157d-42c5-bf05-2238758ba903"
    },
