      "name": "Build Search URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        304
      ],
      "parameters": {
        "jsCode": "const SUPA_URL = 'https://gojpffsrxybbpbdzzrvs.supabase.co/rest/v1/hunter_search_urls';\nconst SUPA_KEY = '{{SUPABASE_SERVICE_ROLE_KEY}}';\nconst qp = { toString: () => 'select=url%2Cpriority%2Clabel%2Clocation&active=eq.true&order=priority.asc%2Clabel.asc' };\nlet rows = [];\ntry {\n  rows = await this.helpers.httpRequest({\n    method: 'GET',\n    url: SUPA_URL + '?' + qp.toString(),\n    headers: { apikey: SUPA_KEY, Authorization: 'Bearer ' + SUPA_KEY },\n    json: true\n  });\n  if (!Array.isArray(rows)) rows = [];\n} catch (e) {\n  throw new Error('Failed to fetch hunter_search_urls: ' + (e.message || e));\n}\nif (rows.length === 0) {\n  throw new Error('hunter_search_urls returned 0 active rows - check table');\n}\nconst urlConfig = rows.map(r => ({ url: r.url, a: r.priority, l: r.label }));\nreturn [{ json: { searchUrls: rows.map(r => r.url), urlConfig, urlCount: rows.length } }];\n"
      },
      "id": "3f70f01f-8d56-4900-941d-1e1c34f52327"
