        304
      ],
      "parameters": {
        "jsCode": "const items=$input.all();\nlet stats;\ntry { stats=$('Normalize and Filter').first().json; } catch(e) { stats={total:0,unique:0,blocked:0,apifyCost:0}; }\nif(!stats.apifyCost && stats.apifyCost!==0) stats.apifyCost=0;\nif(!stats.total) stats.total=items.length;\nif(!stats.unique) stats.unique=items.length;\nif(!stats.blocked && stats.blocked!==0) stats.blocked=0;\nstats.total=Number(stats.total||0);stats.unique=Number(stats.unique||0);stats.blocked=Number(stats.blocked||0);stats.apifyCost=Number(stats.apifyCost||0);\nlet inputs;\ntry { inputs=$('Dedup Against Seen Roles').all(); } catch(e) { inputs=$('Normalize and Filter').all(); }\nif(!inputs||!inputs.length) inputs=items;\nconst scored=items.map((it,i)=>{\n  const s=it.json.output||it.json;\n  const j=inputs[i]?inputs[i].json:{};\n  return {\n    title:j.title||s.title||'',company:j.company||s.company||'',url:j.url||'',location:j.location||'',\n    job_id:j.id||'',score:s.score||0,archetype:s.archetype||'A',\n    comp_estimate:s.comp_estimate||'unclear',stage:s.stage||'',\n    why_this_role:s.why_this_role||'',cv_base:s.cv_base||'CV-A',\n    auto_rejected:s.auto_rejected||false,rejection_reason:s.rejection_reason||null\n  };\n});\nconst qual=scored.filter(r=>r.score>=9&&!r.auto_rejected);\nconst near=scored.filter(r=>r.score>=7&&r.score<9&&!r.auto_rejected).sort((a,b)=>b.score-a.score).slice(0,3);\nconst cc=scored.length*0.012;const tc=(stats.apifyCost||0)+cc;\nlet msg='';\nif(qual.length){\n  const rb=qual.map(r=>'ROLE: '+r.title+' at '+r.company+'\\nScore: '+r.score+'/10 | Archetype: '+r.archetype+' | Comp: '+r.comp_estimate+' | Stage: '+r.stage+'\\nWhy '+r.score+'/10: '+r.why_this_role+'\\nURL: '+r.url+'\\nCV base: '+r.cv_base).join('\\n\\n---\\n\\n');\n  msg='<b>Hunter Sweep</b>\\n\\n<b>'+qual.length+' qualifying</b>\\n'+stats.total+' scraped | '+stats.unique+' unique | '+scored.length+' scored | '+qual.length+' pipeline (9+)\\n\\n'+rb+'\\n\\nTasks created.\\n\\nCost: $'+Number(tc||0).toFixed(3)+' (Apify $'+Number(stats.apifyCost||0).toFixed(3)+' + Claude $'+Number(cc||0).toFixed(3)+')';\n} else {\n  msg='<b>Hunter Sweep</b>\\n\\n'+stats.total+' scraped | '+stats.unique+' unique | '+scored.length+' scored | 0 pipeline (9+)\\n\\nNo roles cleared 9/10.';\n  if(near.length) msg+='\\n\\nNear misses:\\n'+near.map(r=>'- '+r.title+' at '+r.company+' ('+r.score+'/10)').join('\\n');\n  msg+='\\n\\nCost: $'+Number(tc||0).toFixed(3)+' (Apify $'+Number(stats.apifyCost||0).toFixed(3)+' + Claude $'+Number(cc||0).toFixed(3)+')';\n}\nconst si=scored.map(r=>({job_id:r.job_id||r.url,job_url:r.url,title:r.title,company:r.company,archetype:r.archetype,score:r.score,auto_rejected:r.auto_rejected,rejection_reason:r.rejection_reason}));\nconst ti=qual.map(r=>({agent:'hunter',workstream:'high-score-role',title:r.title+' at '+r.company,description:'Score: '+r.score+'/10 | Archetype: '+r.archetype+' | Comp: '+r.comp_estimate+'\\nWhy: '+r.why_this_role+'\\nURL: '+r.url+'\\nCV: '+r.cv_base,status:'waiting',priority:'pri-1'}));\nreturn[{json:{telegramMsg:msg,seenInserts:si,taskInserts:ti,hasQ:qual.length>0,cost:tc,audit:JSON.stringify({scraped:stats.total,unique:stats.unique,blocked:stats.blocked,scored:scored.length,qualifying:qual.length,cost:tc})}}];"
      },
      "id": "e5dda6d5-83e7-4f83-b4ba-1eccd7a553ec"
    },
