    {
      "name": "Normalize and Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        192
      ],
      "parameters": {
        "jsCode": "const raw=$input.all();let jobs=[];for(const i of raw){if(Array.isArray(i.json))jobs=jobs.concat(i.json);else if(i.json&&(i.json.title||i.json.companyName))jobs.push(i.json);}\nconst norm=jobs.map(j=>({title:j.title||j.jobTitle||'',company:j.companyName||j.company||j.organization||'',location:j.location||j.jobLocation||(j.locations_derived?j.locations_derived[0]:'')||'',url:j.link||j.url||j.jobUrl||'',salary:j.salaryInfo||j.salary_raw||'',description:(j.descriptionHtml||j.description||j.description_text||'').substring(0,4000),seniority:j.seniority||'',companySize:j.linkedin_org_size||'',companyIndustry:j.linkedin_org_industry||'',id:j.id||String(j.linkedin_id||'')}));\nconst seen=new Set();const uniq=norm.filter(j=>{if(!j.url||seen.has(j.url))return false;seen.add(j.url);return true;});\nconst blocked=['meta','amazon','philip morris','altria','british american tobacco','reynolds american','juul','draftkings','fanduel','caesars','mgm resorts','penn entertainment','bet365','flutter','kindred','integral ad science','doubleverify','moat','comscore nielsen','oracle data cloud','nielsen marketing','adobe analytics attribution','marin software','kenshoo','skai'];const clean=uniq.filter(j=>!blocked.some(b=>j.company.toLowerCase().includes(b)));\nreturn [{json:{allJobs:clean,total:jobs.length,unique:uniq.length,blocked:uniq.length-clean.length,apifyCost:uniq.length*0.001}}];"
      },
      "alwaysOutputData": true,
      "id": "5da06b30-8384-4f16-b357-5e269d8396fe"
    },
    {
      "name": "Dedup Against Seen Roles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        192
      ],
      "parameters": {
        "jsCode": "const allJobs = $('Normalize and Filter').first().json.allJobs;\nlet seenUrls = new Set();\ntry {\n  const resp = await this.helpers.httpRequest({\n    method: 'GET',\n    url: 'https://gojpffsrxybbpbdzzrvs.supabase.co/rest/v1/hunter_seen_roles?select=job_url',\n    headers: { 'apikey': '{{SUPABASE_SERVICE_ROLE_KEY}}', 'Authorization': 'Bearer {{SUPABASE_SERVICE_ROLE_KEY}}' },\n    json: true\n  });\n  if (Array.isArray(resp)) seenUrls = new Set(resp.map(r => r.job_url).filter(Boolean));\n} catch (e) {}\nconst fresh = allJobs.filter(j => !seenUrls.has(j.url));\nif (!fresh.length) return [{ json: { _empty: true, skip: allJobs.length, seenCount: seenUrls.size } }];\nreturn fresh.map(j => ({ json: j }));"
      },
      "alwaysOutputData": true,
      "id": "000e5623-5ecf-49be-92d1-47022307a062"
