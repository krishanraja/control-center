    {
      "id": "87b0edd3-f3a7-4a0f-8db3-0b81aa5a3f0b",
      "name": "Detect retention actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const subsResp = $('CTRL subscriptions').first().json;\nconst subs = Array.isArray(subsResp && subsResp.data) ? subsResp.data : [];\nconst churned = $('Churned with email').all().map(i => i.json).filter(x => x && x.email);\nconst recentRows = $('Recent retention').all().map(i => i.json);\nconst seen = new Set(recentRows.map(r => (r.email || '') + '|' + r.kind));\nconst tasks = [];\nconst events = [];\nfunction push(kind, email, product, scid, title, desc) {\n  if (!email || seen.has(email + '|' + kind)) return;\n  seen.add(email + '|' + kind);\n  const id = 'ret-' + kind + '-' + String(scid || email).replace(/[^a-zA-Z0-9]/g, '').slice(0, 40);\n  tasks.push({ id, title, description: desc, agent: 'maya', status: 'waiting', workstream: 'retention' });\n  events.push({ product, email, stripe_customer_id: scid || null, kind, status: 'detected', meta: {} });\n}\nfor (const s of subs) {\n  const email = s.customer && s.customer.email;\n  const scid = s.customer && s.customer.id;\n  if (s.status === 'past_due' || s.status === 'unpaid') {\n    push('dunning', email, 'mm_ctrl', scid, 'Recover CTRL payment: ' + email, 'Subscription ' + s.id + ' is ' + s.status + '. Card failed; recover before it cancels.');\n  } else if (s.cancel_at_period_end && s.status === 'active') {\n    push('cancel_save', email, 'mm_ctrl', scid, 'Save cancelling CTRL sub: ' + email, 'Subscription ' + s.id + ' is set to cancel at period end. Offer the pause or the 30% save.');\n  }\n}\nfor (const c of churned) {\n  push('winback', c.email, c.product, c.stripe_customer_id, 'Win back ' + c.product + ': ' + c.email, 'Churned ' + (c.churned_at || '') + '. Send a win-back.');\n}\nreturn [{ json: { tasks, events, n: tasks.length } }];"
      },
      "executeOnce": true
    },
