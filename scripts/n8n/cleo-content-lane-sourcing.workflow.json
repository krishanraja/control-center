    {
      "name": "Plan Due Lanes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        100
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "function rows(nodeName){const out=[];for(const it of $(nodeName).all()){const j=it.json;if(Array.isArray(j))out.push(...j);else if(j&&j.data&&Array.isArray(j.data))out.push(...j.data);else if(j&&(j.key||j.id||j.lane))out.push(j);}return out;}\nconst cadence=rows('Get Cadence');const configs=rows('Get Lane Configs');const recent=rows('Get Recent Drafts');\nconst byKey={};for(const c of configs){byKey[c.key]=(typeof c.value==='string')?JSON.parse(c.value):c.value;}\nfunction keyFor(cc){return cc.slot?('content_lane_'+cc.lane+'_'+cc.slot):('content_lane_'+cc.lane);}\nconst DAY=86400000,now=Date.now();\nfunction hasRecentDraft(lane,slot,iv){const cutoff=now-(iv||7)*DAY*0.8;return recent.some(r=>r.lane===lane&&(slot?r.lane_slot===slot:true)&&r.state!=='published'&&r.state!=='dropped'&&r.created_at&&new Date(r.created_at).getTime()>=cutoff);}\nconst due=[];\nfor(const cc of cadence){\n  if(!['overdue','due_soon','no_data'].includes(cc.status))continue;\n  if(hasRecentDraft(cc.lane,cc.slot,cc.interval_days))continue;\n  const cfg=byKey[keyFor(cc)];if(!cfg)continue;\n  due.push({json:{lane:cc.lane,slot:cc.slot||null,interval_days:cc.interval_days,format:cfg.format,research_prompt:cfg.research_prompt,draft_system:cfg.draft_system}});\n}\nreturn due;"
      },
      "id": "ab07431c-491d-41c3-8ce9-52f6b2d1fb31"
    },
