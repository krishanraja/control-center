        "jsonBody": "={{ { model:'claude-sonnet-4-6', max_tokens:4000, temperature:0.5, system: $('Plan Due Lanes').item.json.draft_system + ' Keep the body within ~700 words so the JSON stays complete.', messages:[{role:'user', content:'Research to ground the piece (cite named facts, do not invent):\\n' + (((($json.choices||[])[0]||{}).message||{}).content||'') + '\\n\\nWrite the piece now. Return ONLY a single JSON object: {\"title\":string,\"body\":string,\"visual_suggestion\":string|null,\"sources\":[url]}.' }] } }}",
