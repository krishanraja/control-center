    {
      "name": "Map Idea Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        100
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const cfg=$('Plan Due Lanes').item.json;\nlet txt=(($json.content||[])[0]||{}).text||'{}';\nfunction rj(t){t=String(t).trim();if(t.startsWith('```'))t=t.split('```')[1].replace(/^json/,'').trim();try{return JSON.parse(t);}catch(e){}const i=t.indexOf('{'),j=t.lastIndexOf('}');if(i>=0&&j>i){try{return JSON.parse(t.slice(i,j+1));}catch(e){}}return null;}\nlet d=rj(txt)||{title:'(parse failed)',body:String(txt).slice(0,2000)};\nconst pres=$('Perplexity Research').item.json;\nconst ptext=(((pres.choices||[])[0]||{}).message||{}).content||'';\nconst cites=pres.citations||[];\nfunction slug(s){return (s||'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/-+/g,'-').replace(/^-|-$/g,'').slice(0,50);}\nconst row={idea:(d.title||'Untitled draft'),body:(d.body||''),lane:cfg.lane,lane_slot:cfg.slot,state:'drafting',source_type:'lane_sourcing',distribution:[],source_url:((d.sources&&d.sources[0])||cites[0]||null),source_snippet:String(ptext).slice(0,500),meta:{research:cites.slice(0,8),sources:(d.sources||cites||[]),visual_suggestion:(d.visual_suggestion||null),generated_by:'lane_sourcing',lane_format:cfg.format},concept_id:'concept:content:'+cfg.lane+':'+slug(d.title||'')+'-'+Date.now()};\nreturn { insert_row: row };",
        "mode": "runOnceForEachItem"
      },
      "id": "5dd8ee66-918c-48a5-a37e-36d0f2f1cf2b"
    },
