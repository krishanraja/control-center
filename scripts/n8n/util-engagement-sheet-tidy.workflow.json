    {
      "id": "b71f4268-3133-4ab4-9e14-ed0b8049060f",
      "name": "Build Tidy Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const sheets = $json.sheets || [];\nconst requests = [];\n\n// Hide anything whose title starts with these prefixes (handles renamed tabs)\nconst hidePrefixes = ['Post-4pm','Actions','Scenario','Archive','Namaste'];\nsheets.forEach(s => {\n  const t = s.properties.title;\n  if (hidePrefixes.some(p => t.startsWith(p))) {\n    requests.push({updateSheetProperties:{properties:{sheetId:s.properties.sheetId,hidden:true},fields:'hidden'}});\n  }\n});\n\n// Order visible tabs, matching by prefix so renames do not break it\nconst order = ['Dashboard','War Plan','Guest List','Fun & Immersive','Anna - Confirmed','Costings'];\norder.forEach((prefix,i) => {\n  const s = sheets.find(x => x.properties.title.startsWith(prefix));\n  if (s) requests.push({updateSheetProperties:{properties:{sheetId:s.properties.sheetId,index:i},fields:'index'}});\n});\n\nreturn [{json:{requests, hiding: requests.length}}];"
      }
    },
    {
      "id": "818795fd-f230-4ae5-88f3-7b8f980c54ca",
      "name": "Apply Tidy",
