    {
      "name": "Build Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// Build the reconciliation plan from the Stripe response + price map. No secrets in this node.\n// Stripe (all four active accounts) is ground truth for subscription customers; webhooks stay as fast alerts.\nconst cfgRows = $('Fetch Price Map').first().json;\nlet priceMap = {};\ntry { const row = Array.isArray(cfgRows) ? cfgRows[0] : (cfgRows && cfgRows.body ? cfgRows.body[0] : cfgRows); const v = row && row.value; if (v) priceMap = (typeof v === 'string') ? JSON.parse(v) : v; } catch (e) {}\nconst ACCOUNT_NODES = ['Fetch Stripe Subscriptions', 'Fetch Stripe Fulltime', 'Fetch Stripe Fractionl'];\nlet subs = []; let hasMore = false;\nfor (const nn of ACCOUNT_NODES) {\n  let resp = null;\n  try { resp = $(nn).first().json; } catch (e) { resp = null; }\n  if (resp && Array.isArray(resp.data)) { subs = subs.concat(resp.data); hasMore = hasMore || !!resp.has_more; }\n}\n\nconst LIVE = ['active', 'trialing', 'past_due'];\nconst upserts = []; const unmapped = {}; const activeSet = new Set();\nfor (const s of subs) {\n  if (!LIVE.includes(s.status)) continue;\n  const item = s.items && s.items.data && s.items.data[0];\n  const price = item && item.price;\n  const priceId = price && price.id;\n  const product = priceMap[priceId] || (price && priceMap[price.product]) || null;\n  if (!product) { if (priceId) unmapped[priceId] = ((price.nickname || '') + ' ' + ((price.unit_amount || 0) / 100) + ' ' + (price.currency || '')).trim(); continue; }\n  const cust = (typeof s.customer === 'object' && s.customer) ? s.customer : {};\n  const custId = cust.id || s.customer;\n  activeSet.add(product + '|' + custId);\n  upserts.push({ product, kind: 'paid', email: cust.email || null, full_name: cust.name || null,\n    stripe_customer_id: custId, stripe_subscription_id: s.id,\n    plan: (price && (price.nickname || priceId)) || null,\n    mrr_usd: (function(){ if (!price || price.unit_amount == null) return null;\n      var amt = price.unit_amount / 100;\n      var iv = (price.recurring && price.recurring.interval) || 'month';\n      var months = iv === 'year' ? 12 : (iv === 'week' ? (1/4.33) : (iv === 'day' ? (1/30) : 1));\n      var FX = { usd: 1, aud: 0.65, eur: 1.08, gbp: 1.27 }; // rough, honest-enough; revisit if non-usd volume grows\n      var fx = FX[String(price.currency || 'usd').toLowerCase()] || 1;\n      return Math.round((amt / months) * fx * 100) / 100; })(),\n    became_paid_at: s.start_date ? new Date(s.start_date * 1000).toISOString() : null,\n    churned_at: null, source: 'stripe_reconciliation', attribution_confidence: 'reconciled' });\n}\nconst paidRowsResp = $('Fetch OS Paid Rows').first().json;\nconst paidRows = Array.isArray(paidRowsResp) ? paidRowsResp : ((paidRowsResp && paidRowsResp.body) ? paidRowsResp.body : $('Fetch OS Paid Rows').all().map(i => i.json));\nconst churnIds = [];\nconst mapped = [...new Set(Object.values(priceMap))];\nfor (const r of paidRows) {\n  if (!r.stripe_customer_id || !mapped.includes(r.product)) continue;\n  if (!activeSet.has(r.product + '|' + r.stripe_customer_id)) churnIds.push(r.id);\n}\nreturn [{ json: {\n  upserts, has_upserts: upserts.length > 0,\n  churn_filter: churnIds.length > 0 ? 'id=in.(' + churnIds.join(',') + ')' : null, has_churn: churnIds.length > 0,\n  unmapped, has_unmapped: Object.keys(unmapped).length > 0,\n  stats: { subs_seen: subs.length, upserts: upserts.length, churn: churnIds.length, unmapped: Object.keys(unmapped).length, stripe_has_more_unfetched: hasMore },\n} }];\n"
      },
