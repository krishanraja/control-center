    {
      "name": "Merge and Write Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst items = $input.all();\nconst hiRow = items.find(i => i.json.body || (Array.isArray(i.json) && i.json[0]?.metrics));\nconst metricsItem = items.find(i => i.json.metrics);\n\nlet existingMetrics = [];\ntry {\n  const hiBody = hiRow?.json?.body || hiRow?.json || [];\n  const hiData = Array.isArray(hiBody) ? hiBody[0] : hiBody;\n  existingMetrics = Array.isArray(hiData?.metrics) ? hiData.metrics : [];\n} catch(e) { existingMetrics = []; }\n\nconst newMetrics = metricsItem?.json?.metrics || [];\n\n// Upsert new metrics into existing array\nfor (const nm of newMetrics) {\n  const idx = existingMetrics.findIndex(m => m.id === nm.id);\n  if (idx >= 0) existingMetrics[idx] = nm;\n  else existingMetrics.push(nm);\n}\n\nreturn [{ json: { merged_metrics: existingMetrics, summary: metricsItem?.json || {} } }];\n"
      },
      "id": "69da824c-0c66-4be9-ad45-a7986c749c37"
