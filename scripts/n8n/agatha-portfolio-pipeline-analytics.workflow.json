    {
      "name": "Aggregate Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst allItems = $input.all();\nconst tasks = [];\nconst signals = [];\n\nfor (const item of allItems) {\n  const body = item.json.body || item.json;\n  if (Array.isArray(body)) {\n    for (const row of body) {\n      if (row.workstream) tasks.push(row);\n      else if (row.signal_score !== undefined) signals.push(row);\n    }\n  }\n}\n\n// Use structured tier column now (not regex on krish_notes)\nconst tier1 = tasks.filter(t => t.tier === 1).length;\nconst tier2 = tasks.filter(t => t.tier === 2).length;\nconst approved = tasks.filter(t => ['in_progress','done'].includes(t.status)).length;\nconst total_inbound = tasks.length + signals.length;\nconst eligible = tier1 + tier2;\nconst approval_rate = eligible > 0 ? Math.round((approved / eligible) * 100) : 0;\n\nconst by_track = {};\nfor (const t of tasks) {\n  const v = t.venture || 'unknown';\n  by_track[v] = (by_track[v] || 0) + 1;\n}\n\nconst metrics = [\n  { id: 'pipeline_inbound_7d', label: 'Pipeline (7d)', value: total_inbound },\n  { id: 'pipeline_tier1', label: 'Tier 1 Leads', value: tier1 },\n  { id: 'pipeline_approved', label: 'Approved (7d)', value: approved, progress_pct: approval_rate },\n  { id: 'pipeline_by_track', label: 'By Track', value: JSON.stringify(by_track) }\n];\n\nreturn [{ json: { metrics, tier1, tier2, approved, total_inbound, approval_rate } }];\n"
      },
      "id": "6dc75f28-ce27-4664-9ccb-f2081b35f824"
    },
