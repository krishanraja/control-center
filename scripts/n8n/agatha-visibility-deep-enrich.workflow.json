      "position": [240, 280],
      "webhookId": "visibility-deep-enrich",
      "parameters": {
        "path": "visibility-deep-enrich",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 280],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst id = body.visibility_target_id || body.target_id || body.id;\nif (!id) throw new Error('visibility_target_id required');\nreturn [{ json: { visibility_target_id: id } }];"
      }
    },
    {
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 144],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, visibility_target_id: $json.visibility_target_id }) }}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "name": "Fetch Target",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 280],
      "parameters": {
        "method": "GET",
        "url": "=https://gojpffsrxybbpbdzzrvs.supabase.co/rest/v1/visibility_targets?id=eq.{{ $json.visibility_target_id }}&select=id,title,type,event_url,cfp_url,event_start_at,deadline_at,audience_size,why_relevant,quality_score,enrichment_version,deep_enriched_at",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "credentials": { "supabaseApi": { "name": "Supabase account 2" } }
    },
    {
      "name": "Brave Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 280],
      "parameters": {
        "method": "GET",
        "url": "=https://api.search.brave.com/res/v1/web/search?q={{ encodeURIComponent([$json[0]?.title, $json[0]?.type, 'speakers audience'].filter(Boolean).join(' ').trim()) }}&count=4",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "credentials": { "httpHeaderAuth": { "name": "Brave Search API" } }
    },
    {
      "name": "Sonnet Enrich",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 280],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 1024, system: 'You re-score a Mindmaker visibility target (CFP, podcast, summit, panel) given fresh public context. Return ONLY a JSON object with keys: relevance_score (int 0-10), audience_size (int or null), quality_score (one of: green, amber, red), why_relevant (1 sentence, opinionated, no em dashes), recommended_angle (1 sentence, suggested talk hook), next_step (action verb + object). Krish Raja is a senior advisor on AI literacy for media + advertising + commerce executives. Not academic, not motivational. Skip events with no senior decision-makers in the room.', messages: [{ role: 'user', content: 'Target: ' + JSON.stringify($('Fetch Target').item.json[0]) + '\\n\\nBrave results:\\n' + JSON.stringify(($json.web?.results || []).slice(0,4)) }] }) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "credentials": { "httpHeaderAuth": { "name": "Anthropic Header" } }
    },
    {
      "name": "Parse Sonnet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 280],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const item = $input.first();\nconst blocks = item.json.content || [];\nconst text = blocks.map(b => b.text || '').join('\\n').trim();\nlet parsed = null;\ntry {\n  const a = text.indexOf('{');\n  const b = text.lastIndexOf('}');\n  if (a >= 0 && b > a) parsed = JSON.parse(text.slice(a, b + 1));\n} catch (e) { parsed = null; }\nconst src = $('Fetch Target').item.json[0] || {};\nconst nextVersion = ((src.enrichment_version || 0) | 0) + 1;\nreturn [{ json: { id: src.id, enrichment_version: nextVersion, ...(parsed || {}) } }];"
      }
    },
    {
      "name": "Patch Target",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 280],
      "parameters": {
        "method": "PATCH",
        "url": "=https://gojpffsrxybbpbdzzrvs.supabase.co/rest/v1/visibility_targets?id=eq.{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Prefer", "value": "return=minimal" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ relevance_score: $json.relevance_score ?? null, audience_size: $json.audience_size ?? null, quality_score: $json.quality_score ?? null, why_relevant: $json.why_relevant ?? null, recommended_angle: $json.recommended_angle ?? null, next_step: $json.next_step ?? null, deep_enriched_at: new Date().toISOString(), enrichment_version: $json.enrichment_version }) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "credentials": { "supabaseApi": { "name": "Supabase account 2" } }
    },
    {
