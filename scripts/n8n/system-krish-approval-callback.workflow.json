      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst callback = body.callback_query;\nif (!callback) {\n  return [{ json: { error: 'no_callback_query', body: body } }];\n}\nconst data = callback.data || '';\nconst parts = data.split('|');\nconst action = parts[0];\nconst draftId = parts[1];\nconst messageId = callback.message && callback.message.message_id;\nconst chatId = callback.message && callback.message.chat && callback.message.chat.id;\nconst callbackQueryId = callback.id;\nreturn [{\n  json: {\n    action: action,\n    draft_id: draftId,\n    message_id: messageId,\n    chat_id: chatId,\n    callback_query_id: callbackQueryId\n  }\n}];"
