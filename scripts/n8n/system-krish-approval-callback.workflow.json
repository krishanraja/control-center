      "parameters": {
        "jsCode": "const decision = $('Parse Callback').first().json;\nconst raw = $input.first().json;\nlet approval = null;\nif (raw && raw.id && raw.draft_id) {\n  approval = raw;\n} else if (Array.isArray(raw) && raw.length > 0) {\n  approval = raw[0];\n} else if (raw && Array.isArray(raw.data) && raw.data.length > 0) {\n  approval = raw.data[0];\n}\nif (!approval || !approval.id) {\n  return [{ json: { error: 'no_pending_approval', draft_id: decision.draft_id, decision: decision, raw_shape: typeof raw } }];\n}\nconst newStatus = decision.action === 'approve' ? 'approved' : 'rejected';\nreturn [{\n  json: {\n    action: decision.action,\n    draft_id: decision.draft_id,\n    message_id: decision.message_id,\n    chat_id: decision.chat_id,\n    callback_query_id: decision.callback_query_id,\n    approval_id: approval.id,\n    status: newStatus,\n    payload: approval.payload,\n    target_webhook_url: approval.target_webhook_url,\n    title: approval.title,\n    source_workflow: approval.source_workflow,\n    agent_name: approval.agent_name\n  }\n}];"
