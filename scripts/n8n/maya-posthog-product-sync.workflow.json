{
  "name": "Maya | PostHog Product Sync",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  },
  "nodes": [
    {
      "name": "Daily 06:30 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [240, 240],
      "parameters": {
        "rule": { "interval": [{ "field": "days", "daysInterval": 1, "triggerAtHour": 6, "triggerAtMinute": 30 }] }
      }
    },
    {
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 420],
      "parameters": {}
    },
    {
      "name": "Build query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 320],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// 7-day rolling per-product rollup. product is the super-property registered\n// in each app's PostHog init, so one shared project separates ventures.\nconst query = \"SELECT properties.product AS product, count(DISTINCT person_id) AS active_users, countIf(event = '$pageview') AS pageviews, count() AS events FROM events WHERE timestamp >= now() - INTERVAL 7 DAY AND properties.product IS NOT NULL GROUP BY product\";\nreturn [{ json: { query: { kind: 'HogQLQuery', query } } }];"
      }
    },
    {
      "name": "PostHog query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [720, 320],
      "parameters": {
        "method": "POST",
        "url": "https://us.posthog.com/api/projects/517641/query/",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": { "parameters": [{ "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "credentials": { "httpHeaderAuth": { "id": "odnaFGsgEa1trPhd", "name": "PostHog API" } },
      "onError": "continueRegularOutput",
      "notes": "HogQL query API. Bearer personal key (PostHog API credential). Free within limits."
    },
    {
      "name": "Map metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 320],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const resp = $('PostHog query').first().json;\nconst results = Array.isArray(resp && resp.results) ? resp.results : [];\nconst today = new Date().toISOString().slice(0, 10);\nconst rows = results.map(r => ({\n  product: String(r[0]),\n  metric_date: today,\n  window_days: 7,\n  active_users: Number(r[1] != null ? r[1] : 0),\n  pageviews: Number(r[2] != null ? r[2] : 0),\n  events: Number(r[3] != null ? r[3] : 0),\n}));\nreturn [{ json: { rows, n: rows.length } }];"
      },
      "executeOnce": true
    },
    {
      "name": "Upsert product_metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1200, 320],
      "parameters": {
        "method": "POST",
        "url": "https://gojpffsrxybbpbdzzrvs.supabase.co/rest/v1/product_metrics?on_conflict=product,metric_date,window_days",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": { "parameters": [
          { "name": "Prefer", "value": "resolution=merge-duplicates,return=minimal" },
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.rows) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "credentials": { "supabaseApi": { "id": "2yHduC474hSIvO0t", "name": "Supabase account 2" } },
      "executeOnce": true,
      "onError": "continueRegularOutput"
    },
    {
      "name": "Heartbeat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1440, 320],
      "parameters": {
        "method": "POST",
        "url": "https://gojpffsrxybbpbdzzrvs.supabase.co/rest/v1/workflow_runs",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": { "parameters": [
          { "name": "Prefer", "value": "return=minimal" },
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow_id: String($workflow.id), workflow_name: $workflow.name, agent_id: 'maya', outcome: 'posthog-product-sync', outcome_count: $('Map metrics').first().json.n, status: 'success', metadata: { products: $('Map metrics').first().json.n } }) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "credentials": { "supabaseApi": { "id": "2yHduC474hSIvO0t", "name": "Supabase account 2" } },
      "executeOnce": true,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Daily 06:30 UTC": { "main": [[{ "node": "Build query", "type": "main", "index": 0 }]] },
    "Run now":         { "main": [[{ "node": "Build query", "type": "main", "index": 0 }]] },
    "Build query":     { "main": [[{ "node": "PostHog query", "type": "main", "index": 0 }]] },
    "PostHog query":   { "main": [[{ "node": "Map metrics", "type": "main", "index": 0 }]] },
    "Map metrics":     { "main": [[{ "node": "Upsert product_metrics", "type": "main", "index": 0 }]] },
    "Upsert product_metrics": { "main": [[{ "node": "Heartbeat", "type": "main", "index": 0 }]] }
  }
}
