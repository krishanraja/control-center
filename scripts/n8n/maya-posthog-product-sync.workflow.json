      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// 7-day rolling per-product rollup. product is the super-property registered\n// in each app's PostHog init, so one shared project separates ventures.\nconst query = \"SELECT properties.product AS product, count(DISTINCT person_id) AS active_users, countIf(event = '$pageview') AS pageviews, count() AS events FROM events WHERE timestamp >= now() - INTERVAL 7 DAY AND properties.product IS NOT NULL GROUP BY product\";\nreturn [{ json: { query: { kind: 'HogQLQuery', query } } }];"
      }
    },
    {
      "id": "7b5067e7-2a1b-427e-a164-2e4abf16c561",
      "name": "PostHog query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        448,
        96
      ],
      "parameters": {
        "method": "POST",
        "url": "https://us.posthog.com/api/projects/517641/query/",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "credentials": {
