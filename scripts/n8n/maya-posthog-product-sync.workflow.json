          "name": "PostHog API"
        }
      }
    },
    {
      "id": "0db40147-3b51-4c19-8316-724853483424",
      "name": "Map metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const resp = $('PostHog query').first().json;\nconst results = Array.isArray(resp && resp.results) ? resp.results : [];\nconst today = new Date().toISOString().slice(0, 10);\nconst rows = results.map(r => ({\n  product: String(r[0]),\n  metric_date: today,\n  window_days: 7,\n  active_users: Number(r[1] != null ? r[1] : 0),\n  pageviews: Number(r[2] != null ? r[2] : 0),\n  events: Number(r[3] != null ? r[3] : 0),\n}));\nreturn [{ json: { rows, n: rows.length } }];"
      },
      "executeOnce": true
    },
