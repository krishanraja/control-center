    {
      "parameters": {
        "jsCode": "// Build Audit payload for Leo weekly revenue report\nconst d = $input.first().json;\nconst mrr = d.mrr_formatted || (d.mrr != null ? `$${d.mrr}` : 'unknown');\nconst products = d.products_active || 0;\nconst pipeline = d.pipeline_count || 0;\n\nreturn [{\n  json: {\n    audit_payload: {\n      actor: 'leo',\n      event_type: 'revenue-weekly-report',\n      display_message: `Leo weekly revenue pulse: MRR ${mrr}, ${products} active products, ${pipeline} pipeline opportunities.`,\n      details: JSON.stringify({ mrr_formatted: mrr, products_active: products, pipeline_count: pipeline })\n    }\n  }\n}];"
