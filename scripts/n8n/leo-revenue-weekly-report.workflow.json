    {
      "name": "Build Revenue Pulse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// All HTTP Request nodes return fullResponse with .body as array\nfunction getBody(nodeName) {\n  try {\n    const d = $node[nodeName].json;\n    if (d && d.body && Array.isArray(d.body)) return d.body;\n    // fallback: maybe body is the top level\n    const first = $node[nodeName].json;\n    return Array.isArray(first) ? first : [];\n  } catch(e) { return []; }\n}\n\nconst logs = getBody('Read Audit Log');\nconst tasks = getBody('Read Tasks');\nconst metrics = getBody('Read Business Metrics');\nconst costs = getBody('Read Weekly Costs');\nconst stripeRuns = getBody('Read Stripe Events');\nconst funnel = getBody('Read Capture To Paid');\n\nconst week_of = new Date().toISOString().split('T')[0];\nconst allAgents = ['maya', 'hunter', 'priya', 'cleo', 'felix', 'leo', 'nell', 'zara', 'arlo', 'marcus', 'nova', 'vera', 'kai', 'agatha'];\n\nlet completed_tasks = 0;\nfor (const t of tasks) {\n  if (t.status === 'done' || t.status === 'completed') completed_tasks++;\n}\n\nlet activeAgentsSet = new Set();\nfor (const l of logs) { if (l.actor) activeAgentsSet.add(l.actor); }\nfor (const t of tasks) {\n  if (t.owner) activeAgentsSet.add(t.owner);\n  if (t.agent) activeAgentsSet.add(t.agent);\n}\nconst agents_active = Array.from(activeAgentsSet).filter(a => allAgents.includes(a));\nconst agents_silent = allAgents.filter(a => !activeAgentsSet.has(a));\n\nconst total = tasks.length;\nconst pct = total > 0 ? Math.round((completed_tasks / total) * 100) : 0;\n\nlet pulse = 'stalled';\nif (pct >= 60) pulse = 'strong';\nelse if (pct >= 30) pulse = 'moving';\nelse if (completed_tasks > 0) pulse = 'slow';\n\nconst activeStr = agents_active.length > 0 ? agents_active.join(', ') : 'none';\nlet silentStr = 'none';\nif (agents_silent.length > 0 && agents_silent.length <= 3) {\n  silentStr = agents_silent.join(', ');\n} else if (agents_silent.length > 3) {\n  silentStr = agents_silent.slice(0, 3).join(', ') + ' +' + (agents_silent.length - 3) + ' more';\n}\n\nconst revMetric = metrics.find(m => m.id === 'monthly-revenue');\nconst prodMetric = metrics.find(m => m.id === 'active-products');\nconst monthlyRevenue = revMetric ? revMetric.value + ' (target: ' + (revMetric.target || 'n/a') + ', ' + (revMetric.status || 'unknown') + ')' : 'not tracking';\nconst activeProducts = prodMetric ? prodMetric.value + '/' + (prodMetric.target || '?') : 'not tracking';\n\nlet totalCostUsd = 0;\nfor (const c of costs) {\n  const cost = parseFloat(c.cost_estimate_usd);\n  if (!isNaN(cost)) totalCostUsd += cost;\n}\nconst costStr = totalCostUsd > 0 ? '$' + totalCostUsd.toFixed(4) : '$0 (no data yet)';\n\nlet stripeTotal = 0;\nlet stripeCount = 0;\nfor (const s of stripeRuns) {\n  try {\n    const meta = typeof s.metadata === 'string' ? JSON.parse(s.metadata) : s.metadata;\n    if (meta && meta.amount_cents) {\n      stripeTotal += parseInt(meta.amount_cents);\n      stripeCount++;\n    }\n  } catch(e) {}\n}\nconst stripeStr = stripeCount > 0\n  ? '$' + (stripeTotal / 100).toFixed(2) + ' (' + stripeCount + ' payments)'\n  : 'no data (logging may be broken)';\n\nlet funnelLines = [];\nfor (const f of funnel) {\n  funnelLines.push(String(f.lane).replace(/_/g, '-') + ' wk ' + f.week + ': ' + f.captures + ' captured, ' + f.paid_added + ' paid' + (f.capture_to_paid_pct != null ? ' (' + f.capture_to_paid_pct + '%)' : ''));\n}\nconst funnelStr = funnelLines.length > 0 ? funnelLines.slice(0, 6).join('\\n') : 'no capture data yet (lanes arming)';\n\nconst lines = [\n  '\\ud83d\\udcca <b>Leo Friday Pulse</b> // ' + week_of,\n  '',\n  '<b>Tasks:</b> ' + completed_tasks + '/' + total + ' done (' + pct + '%)',\n  '<b>Pulse:</b> ' + pulse,\n  '',\n  '\\ud83d\\udcb0 <b>Revenue</b>',\n  'Monthly: ' + monthlyRevenue,\n  'Stripe MTD: ' + stripeStr,\n  '',\n  '\\ud83c\\udfaf <b>Acquisition funnel (recent weeks)</b>',\n  funnelStr,\n  '',\n  '\\ud83d\\udcbb <b>OS Cost</b>',\n  'This week: ' + costStr,\n  'Active products: ' + activeProducts,\n  '',\n  '\\u2705 Active: ' + activeStr,\n  '\\u26a0\\ufe0f Silent: ' + silentStr,\n  '',\n  'Dive deeper: controlcenter.krishraja.com'\n];\nconst telegramText = lines.join('\\n');\n\nreturn [{ json: {\n  total_tasks: total, completed_tasks, pct, pulse,\n  agents_active: activeStr, agents_silent: silentStr,\n  monthly_revenue: monthlyRevenue, stripe_mtd: stripeStr,\n  os_cost_weekly: costStr, acquisition_funnel: funnelStr, active_products: activeProducts,\n  week_of, telegramText\n}}];"
      },
      "id": "3168f20d-14b7-4676-b991-3d26a28f032e"
