      "typeVersion": 1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "path": "acquisition-reply-inbound",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "notes": "Resend email.received webhooks (both domains) point here. A reply ALWAYS halts the sequence.",
      "id": "bab8e3ec-e99d-4d65-8e98-56c73aa8602f",
      "webhookId": "66ea780c-a115-4de6-9705-a18363572890"
    },
    {
      "name": "Match lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://gojpffsrxybbpbdzzrvs.supabase.co/rest/v1/leads?email=eq.{{ encodeURIComponent((String(($json.body && $json.body.data && $json.body.data.from) || '').match(/<([^>]+)>/) || [null, String(($json.body && $json.body.data && $json.body.data.from) || '')])[1].trim().toLowerCase()) }}&select=id,primary_venture,email&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "{{SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "alwaysOutputData": true,
      "id": "b0c49aab-3bda-4eca-8ab0-4e5914e9dd57"
    },
    {
      "name": "Classify (Haiku)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "{{ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5', max_tokens: 60, messages: [{ role: 'user', content: 'Classify this reply to a product nurture email as exactly one of: positive_intent, unsubscribe, question, auto_reply. Reply with the single label only.\\n\\n' + String(($('Resend Inbound Webhook').first().json.body && $('Resend Inbound Webhook').first().json.body.data && $('Resend Inbound Webhook').first().json.body.data.text) || '').slice(0, 1500) }] }) }}"
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "id": "bec7fb5d-e5db-426e-b2e9-2482cf5cfa89"
    },
    {
      "name": "Build reply row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\n// Resend email.received event shape: { type, created_at, data: { email_id,\n// from, to, subject, text, html } }. from can be 'Name <addr@x>' or bare.\nconst hook = $('Resend Inbound Webhook').first().json;\nconst body = hook.body || hook;\nconst data = body.data || {};\nconst rawFrom = String(data.from || '');\nconst m = rawFrom.match(/<([^>]+)>/);\nconst fromEmail = (m ? m[1] : rawFrom).trim().toLowerCase();\nconst lead = ($('Match lead').first().json || [])[0] || null;\nconst raw = $('Classify (Haiku)').first().json || {};\nconst label = String((raw.content && raw.content[0] && raw.content[0].text) || 'unclassified').trim().toLowerCase();\nconst valid = ['positive_intent', 'unsubscribe', 'question', 'auto_reply'];\nreturn [{ json: {\n  lead_id: lead ? lead.id : null,\n  lane: lead ? lead.primary_venture : null,\n  from_email: fromEmail || null,\n  subject: data.subject || null,\n  body: String(data.text || data.html || '').slice(0, 8000),\n  classification: valid.indexOf(label) >= 0 ? label : 'unclassified',\n}}];\n"
      },
      "id": "e7e44c0d-0a7c-4384-a73e-67bac917f76d"
    },
    {
      "name": "Insert reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1240,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://gojpffsrxybbpbdzzrvs.supabase.co/rest/v1/acquisition_replies",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
