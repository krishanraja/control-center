        "url": "=https://gojpffsrxybbpbdzzrvs.supabase.co/rest/v1/acquisition_sends?lead_id=eq.{{ $('Build reply row').first().json.lead_id }}&status=in.(queued,approved)",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "{{SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'suppressed', error: 'reply received - sequence halted' }) }}"
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "id": "c887b91d-7334-4cfd-a743-50198917416c"
    },
    {
