      "parameters": {
        "jsCode": "const items = $input.all();\nconst newsletters = items.map(it => {\n  const j = it.json || {};\n  if (j._empty || j.error) return null;\n  const headers = (j.payload && j.payload.headers) || [];\n  const getH = (n) => {\n    const h = headers.find(x => (x.name || '').toLowerCase() === n.toLowerCase());\n    return h ? h.value : '';\n  };\n  return {\n    subject: getH('Subject'),\n    from: getH('From'),\n    snippet: (j.snippet || '').slice(0, 240),\n  };\n}).filter(n => n && n.subject);\nreturn [{ json: { newsletters, gmail_count: newsletters.length } }];\n"
