      "parameters": {
        "jsCode": "const items = $input.all();\nconst d = (items[0] && items[0].json) || {};\nconst newsletters = d.newsletters || [];\nconst files = d.inspiration_files || [];\nlet newsletterText;\nif (newsletters.length > 0) {\n  newsletterText = newsletters.map(function(n, i){ return (i+1) + '. [' + (n.from || 'unknown') + '] ' + n.subject + '\\n   ' + (n.snippet || ''); }).join('\\n\\n');\n} else {\n  newsletterText = '(no newsletters in last 7 days)';\n}\nlet filesText;\nif (files.length > 0) {\n  filesText = files.map(function(f, i){ return (i+1) + '. ' + f.name; }).join('\\n');\n} else {\n  filesText = '(no inspiration files)';\n}\nconst userPrompt = 'Given these newsletter subjects and snippets:\\n' + newsletterText + '\\n\\nAnd these inspiration folder items:\\n' + filesText + '\\n\\nExtract:\\n1. newsletter_themes: array of 3-5 recurring themes (each one sentence)\\n2. inspiration_notes: array of 2-3 specific angles or ideas worth exploring\\n\\nReturn as JSON only, no markdown wrapper.';\nconst extract_body = {\n  model: 'claude-haiku-4-5-20251001',\n  max_tokens: 500,\n  temperature: 0.2,\n  system: (($('Build Identity Prepend').first().json.identity_prepend) || '') + 'You extract content themes from newsletters and inspiration materials. Return JSON only with keys newsletter_themes and inspiration_notes, both arrays of strings.',\n  messages: [{ role: 'user', content: userPrompt }],\n};\nreturn [{ json: { extract_body, newsletters, inspiration_files: files, gmail_count: d.gmail_count || 0, drive_count: d.drive_count || 0 } }];\n"
      },
