    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst d = (items[0] && items[0].json) || {};\nlet newsletter_themes = [];\nlet inspiration_notes = [];\ntry {\n  const text = (d.content && d.content[0] && d.content[0].text) || '';\n  const jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    const obj = JSON.parse(jsonMatch[0]);\n    newsletter_themes = Array.isArray(obj.newsletter_themes) ? obj.newsletter_themes : [];\n    inspiration_notes = Array.isArray(obj.inspiration_notes) ? obj.inspiration_notes : [];\n  }\n} catch (e) { newsletter_themes = []; inspiration_notes = []; }\nconst usage = d.usage || {};\nconst inputTokens = usage.input_tokens || 0;\nconst outputTokens = usage.output_tokens || 0;\nconst cost_usd = (inputTokens / 1000000) * 1.0 + (outputTokens / 1000000) * 5.0;\nconst api_calls = 13;\nreturn [{ json: { newsletter_themes, inspiration_notes, cost_usd: Math.round(cost_usd * 100000) / 100000, api_calls } }];\n"
      },
