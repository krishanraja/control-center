      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst probes = [\n  { venture: 'mm_ctrl', product: 'CTRL', query: 'best AI news decision tools for executives 2026' },\n  { venture: 'mm_ctrl', product: 'CTRL', query: 'AI tool to cut through AI news noise' },\n  { venture: 'legibility', product: 'Legibility', query: 'typed product data API for AI agents MCP' },\n  { venture: 'legibility', product: 'Legibility', query: 'best MCP servers for product data' },\n  { venture: 'fractionl_pulse', product: 'Fractionl', query: 'fractional executive tools platforms 2026' },\n  { venture: 'full_time', product: 'Full Time', query: 'AI football recap podcast predictions' },\n];\nreturn probes.map(p => ({ json: p }));\n"
      },
      "id": "41f1e927-fa60-45b6-879f-22134435a343"
    },
    {
      "name": "Ask Perplexity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.perplexity.ai/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{PERPLEXITY_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'sonar-pro', messages: [{ role: 'user', content: $json.query }], max_tokens: 500 }) }}"
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "id": "6b74251f-7806-4307-83b0-8041db71e9fe"
    },
    {
      "name": "Score citation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\n// Deterministic string check - no LLM judging an LLM.\nconst probes = $('Product query matrix').all().map(i => i.json);\nconst answers = $('Ask Perplexity').all();\nreturn answers.map((a, idx) => {\n  const p = probes[idx] || {};\n  const text = String((a.json && a.json.choices && a.json.choices[0] && a.json.choices[0].message && a.json.choices[0].message.content) || '');\n  const cited = text.toLowerCase().indexOf(String(p.product || '').toLowerCase()) >= 0;\n  return { json: {\n    signal_type: 'geo-citation', venture: p.venture,\n    description: 'GEO probe: \"' + p.query + '\" - ' + p.product + (cited ? ' IS cited' : ' not cited'),\n    summary: text.slice(0, 400), signal_score: cited ? 8 : 2, status: 'new',\n    raw_data: { cited: cited, surface: 'perplexity_sonar_pro', query: p.query, product: p.product },\n  }};\n});\n"
      },
      "id": "64109c73-3264-45a1-87cd-aef7ca1edbdf"
    },
