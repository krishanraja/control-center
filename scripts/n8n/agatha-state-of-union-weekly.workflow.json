    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.anthropic_body }}",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Call Anthropic Sonnet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1488,
        464
      ],
      "credentials": {
        "anthropicApi": {
          "id": "NqmXYF7Q7sJg5Iog",
          "name": "Anthropic account"
        }
      },
      "onError": "continueErrorOutput",
      "id": "411471db-d8a2-4252-ac0a-19cb282ed8aa"
