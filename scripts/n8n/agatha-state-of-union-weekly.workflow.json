    {
      "parameters": {
        "jsCode": "const synth = $('Build Doc HTML').item.json;\nconst drive = $('Upload to Drive').item.json;\nconst docId = drive.id;\n\nconst summaryObj = {\n  headline: 'Week of ' + synth.week_end + ' State of Union',\n  body: synth.exec_summary || 'See full doc for details.',\n  recommended_focus: synth.recommended_focus || (synth.opportunities[0] || '')\n};\n\nconst patch_body = {\n  summary: JSON.stringify(summaryObj),\n  generated_at: new Date().toISOString()\n};\n\nreturn [{ json: { patch_body, doc_id: docId, doc_url: drive.webViewLink, week_end: synth.week_end, run_start_iso: synth.run_start_iso } }];\n"
      },
