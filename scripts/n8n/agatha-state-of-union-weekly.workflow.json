    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst raw = item.content && item.content[0] && item.content[0].text ? item.content[0].text : '';\nconst cleaned = raw.replace(/\\u2014/g, '-').replace(/\\u2013/g, '-');\n\nconst weekEnd = $('Build Synthesis Prompt').item.json.week_end;\nconst runStartIso = $('Build Synthesis Prompt').item.json.run_start_iso;\nconst docTitle = '[State] MindMaker OS Week of ' + weekEnd;\n\nconst lines = cleaned.split('\\n');\nlet execSummary = '';\nlet opportunities = [];\nlet currentSection = null;\nconst buckets = { exec: [], highlights: [], lowlights: [], opportunities: [] };\n\nfor (const line of lines) {\n  const trimmed = line.trim();\n  const lower = trimmed.toLowerCase();\n  if (lower.startsWith('## exec') || lower.match(/^#+\\s*exec/)) { currentSection = 'exec'; continue; }\n  if (lower.startsWith('## highlights') || lower.match(/^#+\\s*highlights/)) { currentSection = 'highlights'; continue; }\n  if (lower.startsWith('## lowlights') || lower.match(/^#+\\s*lowlights/)) { currentSection = 'lowlights'; continue; }\n  if (lower.startsWith('## opportunities') || lower.match(/^#+\\s*opportunities/)) { currentSection = 'opportunities'; continue; }\n  if (currentSection && trimmed) buckets[currentSection].push(trimmed);\n}\n\nexecSummary = buckets.exec.join(' ').slice(0, 800);\nopportunities = buckets.opportunities.filter(l => l.match(/^[\\-\\*\\d]/)).slice(0, 3);\nconst recommendedFocus = (opportunities[0] || '').replace(/^[\\-\\*\\d\\.\\)\\s]+/, '').trim();\n\nfunction inlineFormat(text) {\n  text = text.replace(/\\*\\*(.+?)\\*\\*/g, '<strong>$1</strong>');\n  text = text.replace(/\\*(.+?)\\*/g, '<em>$1</em>');\n  text = text.replace(/`([^`]+)`/g, '<code>$1</code>');\n  return text;\n}\n\nfunction mdToHtml(text) {\n  const ls = text.split('\\n');\n  const out = [];\n  for (const line of ls) {\n    const t = line.trim();\n    if (t === '') continue;\n    if (/^#{1,6}\\s/.test(t)) {\n      const level = t.match(/^(#+)/)[1].length;\n      const content = t.replace(/^#+\\s+/, '');\n      out.push('<h' + level + '>' + inlineFormat(content) + '</h' + level + '>');\n    } else if (/^[\\-\\*]\\s/.test(t)) {\n      out.push('<li>' + inlineFormat(t.replace(/^[\\-\\*]\\s+/, '')) + '</li>');\n    } else {\n      out.push('<p>' + inlineFormat(t) + '</p>');\n    }\n  }\n  return out.join('\\n');\n}\n\nconst bodyHtml = mdToHtml(cleaned);\nconst html = '<html><head><style>body{font-family:Arial,sans-serif;font-size:11pt;line-height:1.5}h1{font-size:18pt;margin-bottom:12pt}h2{font-size:14pt;margin-top:16pt;margin-bottom:8pt}p{margin:0 0 10pt 0}li{margin-bottom:4pt}</style></head><body><h1>' + docTitle + '</h1>\\n' + bodyHtml + '</body></html>';\n\nconst folderId = '1JIdyXTnf0zvSUQPg_8oK5F-rI82sQVeV';\nconst boundary = 'sou_boundary_' + Date.now();\nconst metadata = JSON.stringify({ name: docTitle, mimeType: 'application/vnd.google-apps.document', parents: [folderId] });\nconst multipart_body = '--' + boundary + '\\r\\nContent-Type: application/json; charset=UTF-8\\r\\n\\r\\n' + metadata + '\\r\\n--' + boundary + '\\r\\nContent-Type: text/html; charset=UTF-8\\r\\n\\r\\n' + html + '\\r\\n--' + boundary + '--';\n\nreturn [{ json: { multipart_body, multipart_boundary: boundary, doc_title: docTitle, week_end: weekEnd, run_start_iso: runStartIso, exec_summary: execSummary, recommended_focus: recommendedFocus, opportunities, synthesis: cleaned } }];\n"
      },
