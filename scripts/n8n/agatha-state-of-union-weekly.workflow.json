    {
      "parameters": {
        "jsCode": "// === Agent Plan (CURRENT PLAN block) ===\nlet plan = {};\nlet plan_stale = false;\ntry {\n  const planRaw = $('Load Agatha Plan').first().json;\n  const planArr = Array.isArray(planRaw) ? planRaw : (planRaw.data ? (typeof planRaw.data === 'string' ? JSON.parse(planRaw.data) : planRaw.data) : [planRaw]);\n  plan = (Array.isArray(planArr) ? planArr[0] : planArr) || {};\n} catch(e) { plan = {}; }\nconst STALE_HOURS = 72;\nif (!plan.last_rendered_at) {\n  plan_stale = true;\n} else {\n  const ageHours = (Date.now() - new Date(plan.last_rendered_at).getTime()) / 3600000;\n  plan_stale = ageHours > STALE_HOURS;\n}\nconst planBlock = (plan.current_phase || plan.objective) ? (\n  'CURRENT PLAN:\\n' +\n  (plan.current_phase  ? `Phase: ${plan.current_phase}\\n` : '') +\n  (plan.objective      ? `Objective: ${plan.objective}\\n` : '') +\n  (plan.next_milestone ? `Next milestone: ${plan.next_milestone}\\n` : '') +\n  (plan.blockers       ? `Blockers: ${plan.blockers}\\n` : '') +\n  (plan.doc_link       ? `Plan doc: ${plan.doc_link}\\n` : '') +\n  (plan.status         ? `Status: ${plan.status}\\n` : '') +\n  '\\n'\n) : '';\n\nconst briefRows = $('Load Agatha Brief').all();\nconst briefContent = (briefRows[0] && briefRows[0].json && briefRows[0].json.brief_content) || 'You are Agatha, the operations agent.';\n\nconst auditLog = $('Read Audit Log').all().map(i => i.json);\nconst signals = $('Read Zara Signals').all().map(i => i.json);\nconst tasks = $('Read Tasks').all().map(i => i.json);\nconst productHealth = $('Read Product Health').all().map(i => i.json);\nconst businessMetrics = $('Read Business Metrics').all().map(i => i.json);\nconst veraAudits = $('Read Vera Audits').all().map(i => i.json);\nconst homeIntelRows = $('Read Home Intelligence').all().map(i => i.json);\nconst homeIntel = homeIntelRows[0] || {};\n\nconst taskCounts = tasks.reduce((acc, t) => { acc[t.status] = (acc[t.status] || 0) + 1; return acc; }, {});\nconst topSignals = [...signals].sort((a, b) => (b.signal_score || 0) - (a.signal_score || 0)).slice(0, 5);\nconst productSummary = productHealth.map(p => p.app_name + ': http ' + p.http_status + ', ' + p.system_status).join('; ');\nconst veraLatest = veraAudits[0] || {};\n\nconst weekEnd = $('Record Start Time').item.json.week_end_date;\n\nconst sections = [];\nsections.push('Generate the MindMaker OS Weekly State of Union for the week ending ' + weekEnd + '.');\nsections.push('');\nsections.push('DATA:');\nsections.push('');\nsections.push('Audit log (' + auditLog.length + ' entries last 7d):');\nsections.push(JSON.stringify(auditLog.slice(0, 50), null, 2));\nsections.push('');\nsections.push('Signals (' + signals.length + ' total, top 5 by score):');\nsections.push(JSON.stringify(topSignals, null, 2));\nsections.push('');\nsections.push('Tasks by status: ' + JSON.stringify(taskCounts));\nsections.push('');\nsections.push('Product health: ' + (productSummary || 'no rows'));\nsections.push('');\nsections.push('Business metrics:');\nsections.push(JSON.stringify(businessMetrics, null, 2));\nsections.push('');\nsections.push('Vera audits: ' + veraAudits.length + ' runs, latest quality_score ' + (veraLatest.quality_score != null ? veraLatest.quality_score : 'n/a') + ', clean: ' + (veraLatest.clean != null ? veraLatest.clean : 'n/a'));\nsections.push('');\nsections.push('Home intelligence current summary: ' + (homeIntel.summary || 'none'));\nsections.push('');\nsections.push('OUTPUT FORMAT (4 sections, max 800 words total, no em dashes anywhere. Use markdown headers exactly as shown):');\nsections.push('');\nsections.push('## Exec Summary');\nsections.push('3 bullet points, each one sentence.');\nsections.push('');\nsections.push('## Highlights');\nsections.push('What worked this week, cite specific data.');\nsections.push('');\nsections.push('## Lowlights');\nsections.push('What failed or stalled, cite root cause.');\nsections.push('');\nsections.push('## Opportunities');\nsections.push('3 specific things to do next week.');\nconst userPrompt = sections.join('\\n');\n\nconst anthropic_body = {\n  model: 'claude-sonnet-4-6',\n  max_tokens: 2000,\n  temperature: 0.3,\n  system: briefContent + (planBlock ? '\\n\\n' + planBlock : ''),\n  messages: [{ role: 'user', content: userPrompt }]\n};\n\nreturn [{ json: { anthropic_body, week_end: weekEnd, run_start_iso: $('Record Start Time').item.json.run_start_iso, plan_stale } }];\n"
      },
