      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 280],
      "parameters": {
        "method": "GET",
        "url": "=https://gojpffsrxybbpbdzzrvs.supabase.co/rest/v1/leads?id=eq.{{ $json.body.lead_id }}&select=id,full_name,email,company,title,linkedin_url,why_relevant,primary_tension,assignee_agent",
