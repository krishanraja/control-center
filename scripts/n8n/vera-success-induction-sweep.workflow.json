    {
      "id": "6cbb4abd-1286-43af-9746-149c5ec1e247",
      "name": "Shape Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "let rows = [];\nconst items = $input.all();\nif (items.length === 1 && Array.isArray(items[0].json)) { rows = items[0].json; } else { rows = items.map(i => i.json); }\nrows = rows.filter(r => r && r.pattern_key);\nconst run_id = 'vera_skill_' + Date.now().toString(36);\nconst system = [\n 'You are Vera, the Mindmaker OS reflection layer.',\n 'You read clusters of an agents SUCCESSFUL work (wins) and draft ONE reusable skill per cluster that crystallizes what made it work, so the agent repeats it.',\n 'Return ONLY JSON, no prose, no code fences.',\n 'Shape: { \"skills\": [ { \"pattern_key\": string, \"target_agent_id\": string, \"skill_slug\": string, \"skill_title\": string, \"skill_body\": string, \"confidence\": \"low\"|\"medium\"|\"high\" } ] }.',\n 'skill_body is a concise reusable play in Krish voice: direct, no fluff, phrased as a positive rule grounded in the evidence titles.',\n 'Skip clusters too generic to crystallize.',\n 'No em dashes anywhere. Use commas, colons, parentheses, or line breaks.'\n].join(' ');\nconst anthropic_body = { model: 'claude-sonnet-4-6', max_tokens: 4000, temperature: 0.2, system, messages: [ { role: 'user', content: 'Candidate win-clusters (each has pattern_key, agent_id, task_type, win_count, thumbsup_count, sample_titles):\\n' + JSON.stringify(rows) + '\\n\\nDraft one induced skill per cluster. target_agent_id is the cluster agent_id.' } ] };\nreturn [{ json: { count: rows.length, candidates: rows, run_id, anthropic_body } }];"
      }
    },
