    {
      "id": "db79ab71-9e10-48c8-9e8d-41947b45ae1c",
      "name": "Parse + Validate Skills",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cands = $('Shape Candidates').first().json.candidates || [];\nconst byKey = {};\nfor (const c of cands) { byKey[c.pattern_key] = c; }\nconst item = $input.first().json;\nlet text = (item.content && item.content[0] && item.content[0].text) || item.text || '';\ntext = String(text).trim().replace(/^```(?:json)?\\n?/, '').replace(/\\n?```$/, '');\nlet parsed;\ntry { parsed = JSON.parse(text); } catch (e) { return []; }\nconst skills = Array.isArray(parsed.skills) ? parsed.skills : [];\nconst clean = (x) => String(x == null ? '' : x).replace(/\\u2014/g, ', ').replace(/ -- /g, ', ');\nconst out = [];\nfor (const s of skills) {\n  if (!s || !s.pattern_key || !s.skill_body || !s.target_agent_id) continue;\n  const c = byKey[s.pattern_key];\n  if (!c) continue;\n  const tu = c.thumbsup_count || 0;\n  const conf = tu >= 2 ? 'high' : (tu >= 1 ? 'medium' : 'low');\n  out.push({ json: {\n    proposed_by: 'vera', scope: 'agent', target_agent_id: String(s.target_agent_id),\n    skill_slug: String(s.skill_slug || s.pattern_key).slice(0, 80),\n    skill_title: clean(s.skill_title || 'Induced skill').slice(0, 200),\n    skill_body: clean(s.skill_body).slice(0, 4000),\n    pattern_key: s.pattern_key,\n    evidence_refs: c.evidence_refs || [],\n    evidence_count: c.win_count || (c.evidence_refs || []).length,\n    confidence: conf, status: 'proposed'\n  }});\n}\nreturn out;"
      }
    },
