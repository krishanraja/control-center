    {
      "parameters": {
        "jsCode": "const skillMapRow = $('Fetch Skill Map').first().json;\nconst skillMap = (skillMapRow && skillMapRow[0] && skillMapRow[0].value) || {};\nconst liveResp = $('Fetch Live Workflows').first().json;\nconst liveWorkflows = (liveResp && liveResp.data) ? liveResp.data : [];\nconst veraResp = $('Fetch Vera Findings').first().json;\nconst findings = (veraResp && veraResp[0] && veraResp[0].findings) ? veraResp[0].findings : [];\n\nconst skillIds = new Set(Object.values(skillMap));\nconst liveIds = new Set(liveWorkflows.map(w => w.id));\nconst liveById = Object.fromEntries(liveWorkflows.map(w => [w.id, w]));\n\nconst skillNotLive = [...skillIds].filter(id => !liveIds.has(id));\nconst liveNotSkill = liveWorkflows.filter(w => !skillIds.has(w.id)).map(w => `${w.id} (${w.name})`);\nconst skillActiveLiveInactive = [];\nfor (const id of skillIds) {\n if (liveById[id] && liveById[id].active === false) {\n  skillActiveLiveInactive.push(`${id} (${liveById[id].name})`);\n }\n}\nconst failingSubjects = new Set(findings.filter(f => f.band === 'errors' && f.severity === 'high').map(f => f.subject));\nconst skillHealthyVeraFailing = [];\nfor (const id of skillIds) {\n if (liveById[id] && failingSubjects.has(liveById[id].name)) {\n  skillHealthyVeraFailing.push(`${id} (${liveById[id].name})`);\n }\n}\nconst delta = skillNotLive.length + liveNotSkill.length + skillActiveLiveInactive.length + skillHealthyVeraFailing.length;\nlet report = `Fleet Drift Report\\nGenerated: ${new Date().toISOString()}\\nDelta: ${delta}\\n\\n`;\nif (skillNotLive.length) report += `In skill but not live (${skillNotLive.length}):\\n${skillNotLive.map(s => '- ' + s).join('\\n')}\\n\\n`;\nif (liveNotSkill.length) report += `Live but not in skill (${liveNotSkill.length}):\\n${liveNotSkill.map(s => '- ' + s).join('\\n')}\\n\\n`;\nif (skillActiveLiveInactive.length) report += `Skill says active, n8n inactive (${skillActiveLiveInactive.length}):\\n${skillActiveLiveInactive.map(s => '- ' + s).join('\\n')}\\n\\n`;\nif (skillHealthyVeraFailing.length) report += `Skill says healthy, Vera reports failing (${skillHealthyVeraFailing.length}):\\n${skillHealthyVeraFailing.map(s => '- ' + s).join('\\n')}\\n\\n`;\nif (delta === 0) report += 'No drift detected. Fleet skill is reconciled.\\n';\nreturn [{ json: { workflows_in_skill_but_not_live: skillNotLive, workflows_live_but_not_in_skill: liveNotSkill, workflows_skill_says_active_n8n_says_inactive: skillActiveLiveInactive, workflows_skill_says_healthy_vera_says_failing: skillHealthyVeraFailing, delta_count: delta, report_text: report } }];"
      },
