    {
      "parameters": {
        "jsCode": "// Build Audit payload for Felix Instantly quality check\nconst d = $input.first().json;\nconst campaigns = d.campaigns_total || 0;\nconst flagged = d.flagged_count || 0;\nconst leads = d.leads_total || 0;\nconst bounce = d.bounce_rate != null ? `${d.bounce_rate}%` : 'n/a';\n\nreturn [{\n  json: {\n    audit_payload: {\n      actor: 'felix',\n      event_type: 'instantly_quality',\n      display_message: `Felix Instantly quality: ${campaigns} campaigns, ${leads} leads, ${flagged} flagged, bounce ${bounce}.`,\n      details: JSON.stringify({ campaigns_total: campaigns, flagged_count: flagged, leads_total: leads, bounce_rate: d.bounce_rate, flagged: d.flagged })\n    }\n  }\n}];"
      },
