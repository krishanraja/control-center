    {
      "name": "Build Pipeline + Dedup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "let signals = [];\ntry { signals = $('Read Zara Signals').all().map(i => i.json); } catch(e) { signals = []; }\n\nlet tasks = [];\ntry { tasks = $('Read Tasks').all().map(i => i.json); } catch(e) { tasks = []; }\n\nlet contactedRaw = [];\ntry { contactedRaw = $('Read Contacted Persons').all().map(i => i.json); } catch(e) { contactedRaw = []; }\n\nlet health = [];\ntry { health = $('Read Product Health').all().map(i => i.json); } catch(e) { health = []; }\n\nlet config = [];\ntry { config = $('Read Brief + Voice + Pricing Floors').all().map(i => i.json); } catch(e) { config = []; }\n\nconst pricingFloors = (config.find(c => c && c.key === 'felix_pricing_floors') || {}).value || null;\n\nconst contactedEmails = new Set(contactedRaw.map(r => (r && r.person_email ? String(r.person_email).toLowerCase() : null)).filter(Boolean));\n\nconst now = new Date();\nconst staleLimit = new Date(now.getTime() - (48 * 60 * 60 * 1000));\n\nconst warmPathsNew = [];\nconst warmPathsStale = [];\nconst warmPathsForWrite = [];\nconst contactedForWrite = [];\nlet skippedDedup = 0;\n\nfor (const s of signals) {\n  if (!s) continue;\n  const email = s.person_email ? String(s.person_email).toLowerCase() : null;\n  if (email && contactedEmails.has(email)) { skippedDedup++; continue; }\n  const surfaced = new Date(s.surfaced_at || s.created_at || now.toISOString());\n  const summary = s.summary || s.description || (s.company_name ? 'Signal for ' + s.company_name : 'Signal ID: ' + s.id);\n  const warmPath = { company_name: s.company_name || null, signal_source: 'zara', signal_id: s.id || null, person_email: s.person_email || null, stage: 'warm_path', score: s.score != null ? s.score : null, summary, created_at: now.toISOString() };\n  warmPathsForWrite.push(warmPath);\n  if (email) { contactedForWrite.push({ person_email: email, agent: 'felix', context: 'pipeline outreach', contacted_at: now.toISOString() }); contactedEmails.add(email); }\n  if (surfaced < staleLimit) warmPathsStale.push(summary); else warmPathsNew.push(summary);\n}\n\nreturn [{ json: { warm_paths_new_count: warmPathsNew.length, warm_paths_stale_count: warmPathsStale.length, tasks_open: tasks.length, skipped_dedup: skippedDedup, stale_signals_list: warmPathsStale, new_signals_list: warmPathsNew, warm_paths_for_write: warmPathsForWrite, contacted_for_write: contactedForWrite, has_writes: warmPathsForWrite.length > 0, pricing_floors_loaded: pricingFloors != null, product_health_rows: health.length, mode: 'daily_pipeline' }}];"
      },
      "id": "8b29f354-18e8-4459-a310-3a8e94dc260f"
    },
