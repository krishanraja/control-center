    {
      "name": "Audit Instantly",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        900
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nlet raw = items.length ? items[0].json : {};\n\nlet campaigns = [];\nif (Array.isArray(raw)) campaigns = raw;\nelse if (Array.isArray(raw.items)) campaigns = raw.items;\nelse if (Array.isArray(raw.data)) campaigns = raw.data;\nelse if (Array.isArray(raw.results)) campaigns = raw.results;\n\nconst flagged = [];\nconst summary = [];\n\nfor (const c of campaigns) {\n  if (!c) continue;\n  const name = c.name || c.id || 'unnamed';\n  const status = c.status != null ? c.status : 'unknown';\n  const sent = Number(c.emails_sent || c.sent || (c.stats && c.stats.emails_sent) || 0);\n  const replied = Number(c.replied || (c.stats && c.stats.replied) || c.reply_count || 0);\n  const bounced = Number(c.bounced || (c.stats && c.stats.bounced) || c.bounce_count || 0);\n  const replyRate = sent > 0 ? (replied / sent) * 100 : 0;\n  const bounceRate = sent > 0 ? (bounced / sent) * 100 : 0;\n  const issues = [];\n  if (bounceRate > 5) issues.push('bounce ' + bounceRate.toFixed(1) + '%');\n  if (sent >= 50 && replyRate < 2) issues.push('reply ' + replyRate.toFixed(2) + '%');\n  if (status === 'paused' || status === 2 || status === 'PAUSED') issues.push('paused');\n  const row = { name, status, sent, replied, bounced, reply_rate: Number(replyRate.toFixed(2)), bounce_rate: Number(bounceRate.toFixed(2)), issues };\n  summary.push(row);\n  if (issues.length) flagged.push(row);\n}\n\nreturn [{ json: { campaigns_total: campaigns.length, flagged_count: flagged.length, flagged, summary, mode: 'friday_audit' }}];"
      },
      "id": "48087d6b-b6e3-4273-8592-64648033581e"
    },
