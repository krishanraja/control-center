    },
    {
      "parameters": {
        "jsCode": "// Build Audit payload for Felix pipeline tracker\nconst d = $('Merge For Audit').first().json;\nconst isFriday = d.mode === 'friday_audit';\nconst opps = d.opportunities_total || 0;\nconst value = d.pipeline_value || 0;\nconst valueStr = typeof value === 'number' ? `$${value.toLocaleString()}` : value;\n\nreturn [{\n  json: {\n    audit_payload: {\n      actor: 'felix',\n      event_type: isFriday ? 'pipeline-tracker-friday' : 'pipeline-tracker',\n      display_message: `${isFriday ? 'Felix pipeline Friday audit' : 'Felix pipeline tracker'}: ${opps} active opportunities, ${valueStr} value.`,\n      details: JSON.stringify(d)\n    }\n  }\n}];"
      },
