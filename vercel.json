    },
    {
      "source": "/api/video-studio/:path*",
      "destination": "https://content-engine-flame-nu.vercel.app/api/video-studio/:path*"
    },
    {
      "source": "/api/discover-lens-radar/:path*",
      "destination": "https://content-engine-flame-nu.vercel.app/api/discover-lens-radar/:path*"
