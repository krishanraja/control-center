    },
    {
      "source": "/api/discover-creator-posts",
      "destination": "https://content-engine-flame-nu.vercel.app/api/discover-creator-posts"
    },
    {
      "source": "/api/discover-build-signals",
      "destination": "https://content-engine-flame-nu.vercel.app/api/discover-build-signals"
    },
    {
      "source": "/api/content-engine",
      "destination": "https://content-engine-flame-nu.vercel.app/api/content-engine"
    },
    {
      "source": "/api/concepts",
      "destination": "https://content-engine-flame-nu.vercel.app/api/concepts"
    },
    {
      "source": "/api/triage/sweep",
      "destination": "https://content-engine-flame-nu.vercel.app/api/triage/sweep"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/discover-guest-scout",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/acquisition/governor",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/revenue/sync",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/growth/snapshot",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/growth/stall-check",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/growth/geo-probe",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/growth/council-run",
      "schedule": "0 17 * * 0"
    },
    {
      "path": "/api/health/fleet-reconcile",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/feedback/backfill-embeddings",
      "schedule": "0 4 * * 6"
    },
    {
      "path": "/api/health/connections-sweep",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/spend/ingest",
      "schedule": "15 7 * * *"
    },
    {
      "path": "/api/meter/apify-sync",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/meter/n8n-sync",
      "schedule": "35 */6 * * *"
    },
    {
      "path": "/api/room/monday",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/discover-visibility-targets",
      "schedule": "0 9 * * 2"
    },
    {
      "path": "/api/scorecard/monday",
      "schedule": "30 10 * * 1"
    },
    {
      "path": "/api/scorecard/github-sync",
      "schedule": "0 4 * * 6"
    },
    {
      "path": "/api/architecture/weekly",
      "schedule": "0 13 * * 0"
    },
    {
      "path": "/api/scorecard/friday",
      "schedule": "30 4 * * 6"
    },
    {
      "path": "/api/goals/week-close",
      "schedule": "0 5 * * 6"
    }
  ],
  "functions": {
    "api/spend/ingest.ts": {
      "maxDuration": 300
    },
    "api/health/connections-sweep.ts": {
      "maxDuration": 120
    },
    "api/meter/apify-sync.ts": {
      "maxDuration": 120
    },
    "api/meter/n8n-sync.ts": {
      "maxDuration": 120
    },
    "api/room/monday.ts": {
      "maxDuration": 300
    },
    "api/discover-visibility-targets.ts": {
      "maxDuration": 300
    },
    "api/scorecard/github-sync.ts": {
      "maxDuration": 120
    },
    "api/architecture/weekly.ts": {
      "maxDuration": 60
    },
    "api/scorecard/monday.ts": {
      "maxDuration": 60
    },
    "api/scorecard/friday.ts": {
      "maxDuration": 60
    },
    "api/room/[id]/draft.ts": {
      "maxDuration": 60
    },
    "api/room/seed.ts": {
      "maxDuration": 60
    }
  }
}
